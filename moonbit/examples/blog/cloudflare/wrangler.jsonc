// Cloudflare Workers config for the MoonBit blog; see ../../../README.md.
// `npx wrangler dev` builds the Wasm and serves on http://localhost:8787.
// The Go blog's ../../../../go/examples/blog/workers also deploys as blog, so
// the last deploy wins.
{
  "name": "blog",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "cd ../../.. && make build",
    // Rebuild when the MoonBit sources or the embedded files change under
    // `wrangler dev`. Not ../posts, ../repodocs, or ../assets: the build
    // writes embedded.mbt there.
    "watch_dir": [
      "../../../pkg", "../site", "../worker", "../scripts",
      "../../../../posts", "../../../../slops", "../../../../TODO.md",
      "../../../../go/examples/blog/internal/site/assets", "../../../../docs"
    ]
  },
  "vars": {
    // Public origin for OGP tags, like the Go blog's -base-url. This is the
    // deployed URL, so `wrangler dev` also writes it into OGP tags.
    "BASE_URL": "https://blog.podhmo.workers.dev"
  },
  "assets": {
    // build/content/content.bin, the posts and the repository's documents
    // that `make build` packs into one file, and preview.wasm. The Worker
    // reads content.bin through env.ASSETS with one fetch, as each fetch
    // counts toward the subrequest limit (50 on the Free plan), and passes
    // preview.wasm through; nothing is served directly.
    "directory": "./build/content",
    "binding": "ASSETS",
    // Every request goes through the Worker as before, so the routes and
    // the 404 pages do not change.
    "run_worker_first": true
  }
}
