// The Go blog's site.css, favicon.svg, and code-copy.js, embedded by
// ../scripts/embed-assets.sh into embedded.mbt, which is generated and
// ignored by git.
rule(
  name: "embed-assets",
  command: "sh examples/blog/scripts/embed-assets.sh $output ../go/examples/blog/internal/site",
)

dev_build(
  rule: "embed-assets",
  input: [
    "../../../../go/examples/blog/internal/site/site.css",
    "../../../../go/examples/blog/internal/site/favicon.svg",
    "../../../../go/examples/blog/internal/site/code-copy.js",
  ],
  output: "embedded.mbt",
)
