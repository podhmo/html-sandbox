// The Go blog's site.css, favicon.svg, code-copy.js, and preview.js,
// embedded by ../scripts/embed-assets.sh into embedded.mbt, which is
// generated and ignored by git. preview.wasm and preview.mjs are only
// hashed, for the versions the preview page puts in their URLs.
rule(
  name: "embed-assets",
  command: "sh examples/blog/scripts/embed-assets.sh $output ../go/examples/blog/internal/site",
)

dev_build(
  rule: "embed-assets",
  input: [
    "../../../../go/examples/blog/internal/site/site.css",
    "../../../../go/examples/blog/internal/site/favicon.svg",
    "../../../../go/examples/blog/internal/site/code-copy.js",
    "../../../../go/examples/blog/internal/site/preview.js",
    "../../../../go/examples/blog/internal/site/preview.wasm",
    "../../../../go/examples/blog/internal/site/preview.mjs",
  ],
  output: "embedded.mbt",
)
