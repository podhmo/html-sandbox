// The Go blog's site.css, favicon.svg, code-copy.js, preview.js,
// listen.js, and skim.js, embedded by ../scripts/embed-assets.sh into
// embedded.mbt, which is generated and ignored by git. preview.wasm is
// only hashed, for the version the preview page puts in its URL.
rule(
  name: "embed-assets",
  command: "sh examples/blog/scripts/embed-assets.sh $output ../go/examples/blog/internal/site/assets",
)

dev_build(
  rule: "embed-assets",
  input: [
    "../../../../go/examples/blog/internal/site/assets/site.css",
    "../../../../go/examples/blog/internal/site/assets/favicon.svg",
    "../../../../go/examples/blog/internal/site/assets/code-copy.js",
    "../../../../go/examples/blog/internal/site/assets/preview.js",
    "../../../../go/examples/blog/internal/site/assets/listen.js",
    "../../../../go/examples/blog/internal/site/assets/skim.js",
    "../../../../go/examples/blog/internal/site/assets/preview.wasm",
  ],
  output: "embedded.mbt",
)
