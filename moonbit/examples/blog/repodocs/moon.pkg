// The repository's own documents, TODO.md and docs/**/*.md, and
// docs/blog.metadata.json, which orders them, embedded by
// ../scripts/embed.sh into embedded.mbt, which is generated and ignored by
// git. moon sees edits to TODO.md and files added to or removed from docs/
// itself; `make` regenerates it for the rest.
rule(
  name: "embed-md",
  command: "sh examples/blog/scripts/embed.sh $output .. $input",
)

dev_build(
  rule: "embed-md",
  input: [
    "../../../../TODO.md",
    "../../../../docs",
    "../../../../docs/blog.metadata.json",
  ],
  output: "embedded.mbt",
)
