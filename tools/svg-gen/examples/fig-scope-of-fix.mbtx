---
import { "podhmo/svg-gen" @s }
---

// fig-scope-of-fix.mbtx -- the retry's central fact in space: the
// error names the driver, but the driver sits outside the region
// the agent can change. What it can change (a torch version) is
// inside. Position carries "reachable / not reachable", and
// neither arrow is a process step -- one is the fix that ran,
// one is the cause it skipped.

fn main {
  let c = @s.Canvas::new(margin=14.0)

  // the log line the agent saw
  let log = c.box(
    10.0,
    110.0,
    @s.Auto,
    46.0,
    label="CUDA initialization:\ndriver too old",
    size=12.0,
  )

  // the host, which the agent cannot modify, and the sandbox
  // inside it
  let host = c.box(200.0, 26.0, @s.Fixed(320.0), 250.0, dash=Some("6 5"), rx=14.0)
  c.text(208.0, 46.0, "変更できない領域（ホスト / Windows）", size=11.0, opacity=Some(0.7))

  let sandbox = c.box(220.0, 60.0, @s.Fixed(280.0), 134.0, color=c.color(2), rx=12.0)
  c.text(228.0, 78.0, "変更できる領域（WSL2, root なし）", size=11.0, opacity=Some(0.7))

  // inside: the action that was taken
  let pin = c.box(
    238.0,
    96.0,
    @s.Auto,
    44.0,
    label="torch を cu128 に\n下げる",
    color=c.color(2),
    size=12.0,
  )
  // inside, but out of reach without root
  ignore(
    c.box(
      238.0,
      150.0,
      @s.Auto,
      34.0,
      label="apt で直す",
      dash=Some("4 4"),
      size=12.0,
      opacity=Some(0.6),
    ),
  )
  // outside the sandbox, inside the host: the actual cause
  let driver = c.box(
    232.0,
    212.0,
    @s.Auto,
    44.0,
    label="ドライバを\n更新する",
    color=c.color(3),
    dash=Some("4 4"),
    size=12.0,
  )

  c.arrow(c.anchor(log, @s.E), (pin.x, pin.y + pin.h / 2.0), color=c.color(2))
  // the skipped cause crosses the host border once, entering from
  // below
  c.arrow(
    (log.x + log.w / 2.0, log.y + log.h),
    (driver.x + driver.w / 2.0, driver.y + driver.h),
    via=[
      (log.x + log.w / 2.0, 300.0),
      (driver.x + driver.w / 2.0, 300.0),
    ],
    color=c.color(3),
    dash=Some("5 4"),
  )

  // annotations sit beside the two boxes, so each names its own
  // target
  c.text(
    pin.x + pin.w + 8.0,
    pin.y + pin.h / 2.0,
    "実行された",
    size=11.0,
    opacity=Some(0.75),
    central=true,
  )
  c.text(
    driver.x + driver.w + 8.0,
    driver.y + driver.h / 2.0,
    "原因（範囲の外）",
    size=11.0,
    opacity=Some(0.75),
    central=true,
  )

  // the two facts that make the boundary real, not a preference
  c.text(
    10.0,
    330.0,
    "境界は方針: sudo なし・automount=false・interop=false・/mnt/c は空",
    size=11.0,
    opacity=Some(0.7),
  )

  if !(host.x < sandbox.x && sandbox.x + sandbox.w < host.x + host.w) {
    abort("sandbox sits inside the host region")
  }
  if !(sandbox.y + sandbox.h < driver.y && driver.y + driver.h < host.y + host.h) {
    abort("the driver box is inside the host but below the sandbox")
  }

  println(
    c.render(label="a log line 'driver too old' points two ways: to a torch version inside the region the agent can change, and to a driver update outside it in the host"),
  )
}
