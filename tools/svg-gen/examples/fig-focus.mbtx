---
import { "podhmo/svg-gen" @svg }
---

// fig-focus.mbtx -- focus + context: one node in full strength, its
// neighbours dimmed, drawn without a layout engine.

fn main {
  let c = @svg.Canvas()
  let dim = 0.35

  let focus = c.box(140.0, 60.0, @svg.Fixed(130.0), 46.0, label=Some("focus pkg"))
  let users = c.box(
    c.left_of(focus, 40.0, 110.0),
    60.0,
    @svg.Fixed(110.0),
    46.0,
    label=Some("users of it"),
    size=13.0,
    opacity=Some(dim),
  )
  let lib = c.box(
    focus.x,
    c.above(focus, 24.0, 40.0),
    @svg.Fixed(130.0),
    40.0,
    label=Some("a library"),
    size=13.0,
    opacity=Some(dim),
  )
  let tests = c.box(
    c.right_of(focus, 40.0),
    60.0,
    @svg.Fixed(110.0),
    46.0,
    label=Some("its tests"),
    size=13.0,
    opacity=Some(dim),
  )
  let app = c.box(
    focus.x,
    c.below(focus, 24.0),
    @svg.Fixed(130.0),
    40.0,
    label=Some("the app"),
    size=13.0,
    opacity=Some(dim),
  )

  // Edges join focus anchors to neighbour anchors; also dimmed.
  c.arrow(c.anchor(focus, @svg.W), c.anchor(users, @svg.E), opacity=Some(dim))
  c.arrow(c.anchor(focus, @svg.N), c.anchor(lib, @svg.S), opacity=Some(dim))
  c.arrow(c.anchor(focus, @svg.E), c.anchor(tests, @svg.W), opacity=Some(dim))
  c.arrow(c.anchor(focus, @svg.S), c.anchor(app, @svg.N), opacity=Some(dim))

  if !(users.y == tests.y) {
    abort("side boxes share the row")
  }
  if !(lib.x == app.x) {
    abort("top and bottom boxes share the column")
  }

  println(c.render(label=Some("one package in focus, related packages dimmed")))
}
