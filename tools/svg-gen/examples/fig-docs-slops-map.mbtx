---
import { "podhmo/svg-gen" @s }
---

// fig-docs-slops-map.mbtx -- where each directory's text sits on
// two questions: is it rewritten to stay current, or kept as of
// its date (x)? is its reader someone who will act on it next, or
// someone who wants to know what happened (y)? Positions are
// qualitative. Thin dashed lines join real sketch/slops pairs
// written from the same work; the hollow dot is the rule-writing
// section of a slops article that sits in sketch territory.

fn main {
  let c = @s.Canvas::new(margin=12.0)

  let x0 = 60.0
  let x1 = 560.0
  let y0 = 330.0
  let y1 = 30.0

  c.line((x0, y0), (x1, y0), width=1.5)
  c.line((x0, y0), (x0, y1), width=1.5)
  c.arrow((x1 - 1.0, y0), (x1, y0), width=1.5)
  c.arrow((x0, y1 + 1.0), (x0, y1), width=1.5)
  c.text(x0, y0 + 20.0, "書き直して最新に保つ", size=11.0, opacity=Some(0.75))
  c.text(x1, y0 + 20.0, "日付の時点のまま残す", anchor=@s.End, size=11.0, opacity=Some(0.75))
  c.text(x0 + 8.0, y1 + 4.0, "読み手: 何が起きたかを知りたい人", size=11.0, opacity=Some(0.75))
  c.text(x0 + 8.0, y0 - 10.0, "読み手: 次に手を動かす人やエージェント", size=11.0, opacity=Some(0.75))

  // directory regions: (x, y, w, h, label, palette index, dash)
  let regions = [
    (70.0, 264.0, 180.0, 42.0, "docs/（英語・設計と開発手順）", 0, ""),
    (180.0, 138.0, 190.0, 120.0, "docs/sketch/ja/（調査メモ）", 2, "6 4"),
    (385.0, 72.0, 195.0, 120.0, "slops/（AI が書いた記事）", 3, ""),
    (470.0, 34.0, 110.0, 30.0, "posts/（人間）", 4, "2 3"),
  ]
  let shapes = regions.map(fn(r) {
    let (x, y, w, h, label, k, dash) = r
    let s = c.box(x, y, @s.Fixed(w), h, color=c.color(k), dash=dash, rx=10.0)
    c.text(x + 8.0, y + 15.0, label, size=11.0)
    s
  })

  // real pairs written from the same work: (sketch, slops) names
  let pairs = [
    ("tts-wsl2", "answers-under-constraints"),
    ("dads-illustration-lora", "dads-illustration-lora"),
    ("html-report-skill", "html-report-variations"),
    ("figure-guidelines", "chart-gen"),
  ]
  let pts = pairs.mapi(fn(i, e) {
    let (sk, sl) = e
    let a : @s.Point = (345.0, 190.0 + i.to_double() * 19.0)
    let b : @s.Point = (405.0, 104.0 + i.to_double() * 22.0)
    c.line(a, b, dash="3 3", opacity=Some(0.55), width=1.0, gap=5.0)
    ignore(c.circle(a.0, a.1, 4.0, color=c.color(2), width=2.5))
    ignore(c.circle(b.0, b.1, 4.0, color=c.color(3), width=2.5))
    c.text(a.0 - 9.0, a.1, sk, anchor=@s.End, central=true, size=10.0, opacity=Some(0.85))
    c.text(b.0 + 9.0, b.1, sl, central=true, size=10.0, opacity=Some(0.85))
    (a, b)
  })

  // the prescriptive section of answers-under-constraints sits in
  // sketch land
  let rule : @s.Point = (345.0, 167.0)
  ignore(c.circle(rule.0, rule.1, 6.0, dash="2 2", width=1.5))
  c.line(pts[0].1, rule, dash="1 3", width=1.5, gap=8.0)
  c.text(
    rule.0 - 11.0,
    rule.1,
    "「記録の側でできること」の節",
    anchor=@s.End,
    central=true,
    size=10.0,
  )

  for e in pts {
    let (a, b) = e
    if !(b.0 > a.0 && b.1 < a.1) {
      abort("every slops half sits right of and above its sketch half")
    }
  }
  let sketch = shapes[1]
  let slops = shapes[2]
  if !(
      rule.0 > sketch.x &&
      rule.0 < sketch.x + sketch.w &&
      rule.1 > sketch.y &&
      rule.0 < slops.x
    ) {
    abort("the rule section sits inside the sketch region, outside slops")
  }

  println(
    c.render(label="docs, docs/sketch, slops and posts on two axes (rewritten vs kept as dated; reader acts next vs wants to know what happened), with four real sketch-to-slops pairs and one slops section that sits in sketch territory"),
  )
}
