---
import { "podhmo/svg-gen" @s }
---

// Meaning-drift spectrum for the tekitou article: "適当に" (fitting
// a shared criterion) slides through {よしなに, いい感じに} into
// "テキトーに" (no criterion asked). Position on the axis carries
// the meaning: the strictness of the criterion fades left to right.

fn main {
  let c = @s.Canvas()

  let y = 90.0
  let x0 = 60.0
  let x3 = 620.0

  // the axis itself, with a drift arrowhead at the loose end
  c.line((x0, y), (x3, y), width=2.0)
  c.arrow((x3 - 60.0, y), (x3 + 30.0, y), width=2.0)

  c.text(x0, y - 34.0, "基準が明確（正解が共有されている）", size=12.0, opacity=Some(0.8))
  c.text(x3 + 30.0, y - 34.0, "基準を問わない", anchor=@s.End, size=12.0, opacity=Some(0.8))

  // fading criterion: a bar whose fill thins out left to right
  c.raw(
    "<rect x=\"\{x0}\" y=\"\{y + 46.0}\" width=\"\{x3 - x0}\" height=\"6\" fill=\"currentColor\" fill-opacity=\"0.10\"/>",
    covered=[(x0, y + 46.0), (x3, y + 52.0)],
  )
  c.raw(
    "<polygon points=\"\{x0},\{y + 40.0} \{x0},\{y + 58.0} \{x3},\{y + 58.0}\" fill=\"currentColor\" fill-opacity=\"0.18\"/>",
    covered=[(x0, y + 40.0), (x3, y + 58.0)],
  )
  c.text(x0, y + 74.0, "判断基準の共有度", size=11.0, opacity=Some(0.6))

  // the three stops on the spectrum
  let stops = [
    (x0, "適当に", "適切に・ぴったり", "テストの「最も適当な語句」", 0),
    ((x0 + x3) / 2.0, "よしなに・いい感じに", "判断の丸ごと委任", "依頼の「適当にお願い」", 1),
    (x3, "テキトーに", "いい加減に・ざっくり", "現場の「適当でいいよ」", 3),
  ]

  for st in stops {
    let (x, word, gloss, scene, i) = st
    let col = c.color(i)
    // ring + filled dot so the mark still reads without color
    ignore(c.circle(x, y, 9.0, color=col, width=2.0))
    c.raw("<circle cx=\"\{x}\" cy=\"\{y}\" r=\"4.5\" fill=\"\{col}\"/>", covered=[(x, y)])
    c.text(x, y - 20.0, scene, anchor=@s.Middle, size=11.0, opacity=Some(0.75))
    c.text(x, y + 30.0, word, anchor=@s.Middle, size=14.0)
    c.text(x, y + 100.0, gloss, anchor=@s.Middle, size=11.0, opacity=Some(0.7))
  }

  println(
    c.render(label="「適当に」から「よしなに・いい感じに」を経て「テキトーに」へ。横軸は判断基準の共有度で、右へ行くほど基準を問わない用法になる"),
  )
}
