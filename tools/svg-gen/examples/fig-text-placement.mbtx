---
import {
  "podhmo/svg-gen" @svg,
}
---

// fig-text-placement.mbtx -- labels around a shape reserve baseline-aware
// glyph space. The south label is the important case: its ascent starts
// below the shape instead of the glyph box overlapping the border.

///|
fn main {
  let c = @svg.Canvas()
  let node = c.box(
    90.0,
    70.0,
    @svg.Fixed(120.0),
    64.0,
    label=Some("shape"),
    width=2.0,
  )
  c.label_side(node, @svg.N, "north / baseline-aware")
  c.label_side(node, @svg.S, "south / no overlap")
  c.label_side(node, @svg.W, "west")
  c.label_side(node, @svg.E, "east")

  let m = @svg.text_metrics("measured label", size=12.0)
  ignore(
    c.rect(240.0, 72.0, m.width, m.height, dash=Some("3 3"), opacity=Some(0.5)),
  )
  c.text(240.0, 72.0 + m.ascent, "measured label", size=12.0)
  println(c.render(label=Some("Baseline-aware labels around shapes")))
}
