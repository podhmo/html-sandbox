---
import { "podhmo/svg-gen" @svg }
---

// business/088: 矢羽のプロセス
// category: 数が無い論点
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：矢羽の形の段階を左から右へつなぐ
// reference use: 使う場面：順番のある段階
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.polygon([(4.0, 25.0), (34.0, 25.0), (44.0, 40.0), (34.0, 55.0), (4.0, 55.0), (14.0, 40.0)], width=1.0, color="#2563eb", fill="#dbe8fd")
  c.polygon([(42.0, 25.0), (72.0, 25.0), (82.0, 40.0), (72.0, 55.0), (42.0, 55.0), (52.0, 40.0)], width=1.0, color="#2563eb", fill="#dbe8fd")
  c.polygon([(80.0, 25.0), (110.0, 25.0), (120.0, 40.0), (110.0, 55.0), (80.0, 55.0), (90.0, 40.0)], width=1.0, color="#15803d", fill="#dcf3e3")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("矢羽のプロセス"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
