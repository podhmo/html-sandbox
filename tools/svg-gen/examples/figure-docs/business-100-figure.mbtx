---
import { "podhmo/svg-gen" @svg }
---

// business/100: ロジックモデル
// category: 数が無い論点
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：投入、活動、結果、成果の四角を左から右へ矢印でつなぐ
// reference use: 使う場面：施策が成果につながる道筋
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 30.0, 24.0, 20.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((28.0, 40.0), (33.0, 40.0), color="#2563eb")
  ignore(c.rect(33.0, 30.0, 24.0, 20.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((57.0, 40.0), (62.0, 40.0), color="#2563eb")
  ignore(c.rect(62.0, 30.0, 24.0, 20.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((86.0, 40.0), (91.0, 40.0), color="#2563eb")
  ignore(c.rect(91.0, 30.0, 24.0, 20.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("ロジックモデル"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
