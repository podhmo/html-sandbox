---
import { "podhmo/svg-gen" @svg }
---

// dev/014 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(42.0, 2.0, 36.0, 12.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(60.0, 10.0, "受信", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((60.0, 14.0), (60.0, 22.0), width=1.2, color="#2563eb")
  c.polygon([(60.0, 22.0), (58.0, 18.0), (62.0, 18.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.polygon([(60.0, 22.0), (78.0, 32.0), (60.0, 42.0), (42.0, 32.0)], width=1.0, color="#15803d", fill="#dcf3e3")
  c.line((78.0, 32.0), (94.0, 32.0), width=1.2, color="#2563eb")
  c.polygon([(94.0, 32.0), (90.0, 34.0), (90.0, 30.0)], width=1.0, color="#2563eb", fill="#2563eb")
  ignore(c.rect(94.0, 26.0, 22.0, 12.0, rx=2.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  c.text(105.0, 34.0, "拒否", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((60.0, 42.0), (60.0, 52.0), width=1.2, color="#2563eb")
  c.polygon([(60.0, 52.0), (58.0, 48.0), (62.0, 48.0)], width=1.0, color="#2563eb", fill="#2563eb")
  ignore(c.rect(42.0, 52.0, 36.0, 12.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(60.0, 60.0, "保存", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.text(86.0, 29.0, "NG", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.text(65.0, 49.0, "OK", anchor=@svg.Middle, size=6.0, color="#5d6778")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Flowchart"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
