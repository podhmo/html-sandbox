---
import { "podhmo/svg-gen" @svg }
---

// business/109: 7S
// category: 数が無い論点
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：中央に共有価値観、周りに戦略、組織、仕組み、社風（スタイル）、人材、能力の6つを置き、すべてを線で結ぶ
// reference use: 使う場面：組織の要素が互いにかみ合っているか
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((60.0, 40.0), (90.0, 40.0), width=1.0, color="#d5dae2")
  c.line((60.0, 40.0), (75.0, 66.0), width=1.0, color="#d5dae2")
  c.line((60.0, 40.0), (45.0, 66.0), width=1.0, color="#d5dae2")
  c.line((60.0, 40.0), (30.0, 40.0), width=1.0, color="#d5dae2")
  c.line((60.0, 40.0), (45.0, 14.0), width=1.0, color="#d5dae2")
  c.line((60.0, 40.0), (75.0, 14.0), width=1.0, color="#d5dae2")
  ignore(c.circle(90.0, 40.0, 7.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.circle(75.0, 66.0, 7.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(45.0, 66.0, 7.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.circle(30.0, 40.0, 7.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(45.0, 14.0, 7.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.circle(75.0, 14.0, 7.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(60.0, 40.0, 9.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("7S"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
