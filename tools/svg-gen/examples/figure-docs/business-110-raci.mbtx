---
import { "podhmo/svg-gen" @svg }
---

// business/110: RACI
// category: 数が無い論点
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：行に作業、列に役割を取り、マスに実行（R）、説明責任（A）、相談（C）、報告（I）の記号を置く
// reference use: 使う場面：作業ごとの担当と責任の重なりや抜け
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(30.0, 8.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(41.0, 19.0, "R", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(30.0, 24.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(41.0, 35.0, "A", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(30.0, 40.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(41.0, 51.0, "C", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(30.0, 56.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(41.0, 67.0, "I", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(52.0, 8.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(63.0, 19.0, "A", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(52.0, 24.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(63.0, 35.0, "C", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(52.0, 40.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(63.0, 51.0, "I", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(52.0, 56.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(63.0, 67.0, "-", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(74.0, 8.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(85.0, 19.0, "C", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(74.0, 24.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(85.0, 35.0, "I", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(74.0, 40.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(85.0, 51.0, "-", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(74.0, 56.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(85.0, 67.0, "R", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(96.0, 8.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(107.0, 19.0, "I", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(96.0, 24.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(107.0, 35.0, "-", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(96.0, 40.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(107.0, 51.0, "R", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(96.0, 56.0, 22.0, 16.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  c.text(107.0, 67.0, "A", anchor=@svg.Middle, size=7.0, color="#5d6778")
  ignore(c.rect(6.0, 8.0, 22.0, 16.0, width=1.0, color="none", fill="#d5dae2"))
  ignore(c.rect(6.0, 24.0, 22.0, 16.0, width=1.0, color="none", fill="#d5dae2"))
  ignore(c.rect(6.0, 40.0, 22.0, 16.0, width=1.0, color="none", fill="#d5dae2"))
  ignore(c.rect(6.0, 56.0, 22.0, 16.0, width=1.0, color="none", fill="#d5dae2"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("RACI"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
