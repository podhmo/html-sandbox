---
import { "podhmo/svg-gen" @svg }
---

// dev/019: Data flow diagram
// category: データ
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：外部を四角、処理を円、保存先を上下2本線で描き、データの名前を書いた矢印で結ぶ
// reference use: 使う場面：データがどこから来てどこへ残るか
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 32.0, 22.0, 16.0, rx=2.0, width=1.0, color="#9aa4b5", fill="#d5dae2"))
  c.text(15.0, 42.0, "User", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.circle(56.0, 40.0, 12.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.line((88.0, 26.0), (116.0, 26.0), color="#2563eb")
  c.line((88.0, 38.0), (116.0, 38.0), color="#2563eb")
  c.text(102.0, 34.0, "store", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.circle(56.0, 10.0, 0.0, width=1.0, color="none"))
  c.line((26.0, 40.0), (44.0, 40.0), width=1.2, color="#2563eb")
  c.polygon([(44.0, 40.0), (40.0, 42.0), (40.0, 38.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((68.0, 36.0), (88.0, 32.0), width=1.2, color="#2563eb")
  c.polygon([(88.0, 32.0), (85.0, 34.0), (84.0, 31.0)], width=1.0, color="#2563eb", fill="#2563eb")
  ignore(c.rect(90.0, 56.0, 24.0, 14.0, rx=2.0, width=1.0, color="#9aa4b5", fill="#d5dae2"))
  c.text(102.0, 65.0, "外部", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((66.0, 48.0), (90.0, 62.0), width=1.2, color="#2563eb")
  c.polygon([(90.0, 62.0), (86.0, 62.0), (88.0, 59.0)], width=1.0, color="#2563eb", fill="#2563eb")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Data flow diagram"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
