---
import { "podhmo/svg-gen" @svg }
---

// dev/004: Layer diagram
// category: 構造
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：横の帯を積み、矢印は上から下の向きだけにする
// reference use: 使う場面：層の分け方と、依存してよい向き
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(10.0, 6.0, 100.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(60.0, 15.0, "UI", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(10.0, 24.0, 100.0, 14.0, rx=2.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.text(60.0, 33.0, "Application", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(10.0, 42.0, 100.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(60.0, 51.0, "Domain", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(10.0, 60.0, 100.0, 14.0, rx=2.0, width=1.0, color="#9aa4b5", fill="#d5dae2"))
  c.text(60.0, 69.0, "Infrastructure", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((114.0, 10.0), (114.0, 70.0), width=1.2, color="#c2410c")
  c.polygon([(114.0, 70.0), (112.0, 66.0), (116.0, 66.0)], width=1.0, color="#c2410c", fill="#c2410c")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Layer diagram"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
