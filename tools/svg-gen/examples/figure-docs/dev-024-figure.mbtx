---
import { "podhmo/svg-gen" @svg }
---

// dev/024: クラウドの構成図
// category: 配置
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：Region、VPC、サブネットを入れ子の枠にし、各サービスを置いて通信経路に番号を付ける
// reference use: 使う場面：クラウドの構成と通信の経路
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(2.0, 2.0, 116.0, 76.0, width=1.0, color="#9aa4b5"))
  ignore(c.rect(8.0, 10.0, 104.0, 64.0, dash=Some("3 2"), width=1.0, color="#15803d"))
  ignore(c.rect(14.0, 18.0, 42.0, 50.0, width=1.0, color="#15803d", fill="#f3f8f4"))
  ignore(c.rect(64.0, 18.0, 42.0, 50.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.circle(35.0, 32.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(35.0, 56.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(85.0, 42.0, 7.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  c.line((41.0, 32.0), (78.0, 40.0), width=1.2, color="#2563eb")
  c.polygon([(78.0, 40.0), (74.0, 41.0), (75.0, 38.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.text(58.0, 32.0, "1", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((41.0, 56.0), (78.0, 44.0), width=1.2, color="#2563eb")
  c.polygon([(78.0, 44.0), (75.0, 47.0), (74.0, 43.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.text(58.0, 56.0, "2", anchor=@svg.Middle, size=6.0, color="#5d6778")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("クラウドの構成図"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
