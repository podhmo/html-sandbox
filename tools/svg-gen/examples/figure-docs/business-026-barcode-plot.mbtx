---
import { "podhmo/svg-gen" @svg }
---

// business/026: Barcode plot
// category: 分布
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：分類ごとの線の上に、値を短い縦線で全部置く
// reference use: 使う場面：すべての値を並べたうえで、特定の値の位置を目立たせる
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((28.0, 8.0), (28.0, 24.0), width=1.0, color="#2563eb")
  c.line((69.0, 8.0), (69.0, 24.0), width=1.0, color="#2563eb")
  c.line((78.0, 8.0), (78.0, 24.0), width=1.0, color="#2563eb")
  c.line((79.0, 8.0), (79.0, 24.0), width=2.0, color="#c2410c")
  c.line((96.0, 8.0), (96.0, 24.0), width=1.0, color="#2563eb")
  c.line((96.0, 8.0), (96.0, 24.0), width=1.0, color="#2563eb")
  c.line((101.0, 8.0), (101.0, 24.0), width=1.0, color="#2563eb")
  c.line((103.0, 8.0), (103.0, 24.0), width=1.0, color="#2563eb")
  c.line((107.0, 8.0), (107.0, 24.0), width=1.0, color="#2563eb")
  c.line((109.0, 8.0), (109.0, 24.0), width=1.0, color="#2563eb")
  c.line((18.0, 30.0), (18.0, 46.0), width=1.0, color="#2563eb")
  c.line((33.0, 30.0), (33.0, 46.0), width=1.0, color="#2563eb")
  c.line((40.0, 30.0), (40.0, 46.0), width=1.0, color="#2563eb")
  c.line((68.0, 30.0), (68.0, 46.0), width=2.0, color="#c2410c")
  c.line((68.0, 30.0), (68.0, 46.0), width=1.0, color="#2563eb")
  c.line((82.0, 30.0), (82.0, 46.0), width=1.0, color="#2563eb")
  c.line((93.0, 30.0), (93.0, 46.0), width=1.0, color="#2563eb")
  c.line((96.0, 30.0), (96.0, 46.0), width=1.0, color="#2563eb")
  c.line((101.0, 30.0), (101.0, 46.0), width=1.0, color="#2563eb")
  c.line((109.0, 30.0), (109.0, 46.0), width=1.0, color="#2563eb")
  c.line((16.0, 52.0), (16.0, 68.0), width=1.0, color="#2563eb")
  c.line((16.0, 52.0), (16.0, 68.0), width=1.0, color="#2563eb")
  c.line((21.0, 52.0), (21.0, 68.0), width=1.0, color="#2563eb")
  c.line((27.0, 52.0), (27.0, 68.0), width=2.0, color="#c2410c")
  c.line((41.0, 52.0), (41.0, 68.0), width=1.0, color="#2563eb")
  c.line((52.0, 52.0), (52.0, 68.0), width=1.0, color="#2563eb")
  c.line((72.0, 52.0), (72.0, 68.0), width=1.0, color="#2563eb")
  c.line((87.0, 52.0), (87.0, 68.0), width=1.0, color="#2563eb")
  c.line((90.0, 52.0), (90.0, 68.0), width=1.0, color="#2563eb")
  c.line((98.0, 52.0), (98.0, 68.0), width=1.0, color="#2563eb")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Barcode plot"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
