---
import { "podhmo/svg-gen" @svg }
---

// business/060: Paired column
// category: 大きさ
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：項目ごとに2系列の縦棒を並べる
// reference use: 使う場面：2系列の大きさの比較
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((10.0, 70.0), (112.0, 70.0), width=1.0, color="#9aa4b5")
  c.line((10.0, 6.0), (10.0, 70.0), width=1.0, color="#9aa4b5")
  ignore(c.rect(14.0, 30.0, 8.0, 40.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(22.0, 40.0, 8.0, 30.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(34.0, 20.0, 8.0, 50.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(42.0, 15.0, 8.0, 55.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(54.0, 45.0, 8.0, 25.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(62.0, 35.0, 8.0, 35.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(74.0, 25.0, 8.0, 45.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(82.0, 30.0, 8.0, 40.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(94.0, 40.0, 8.0, 30.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(102.0, 50.0, 8.0, 20.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Paired column"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
