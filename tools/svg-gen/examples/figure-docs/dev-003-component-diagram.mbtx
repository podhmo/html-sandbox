---
import { "podhmo/svg-gen" @svg }
---

// dev/003: Component diagram
// category: 構造
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：1つの実行単位の中を部品に分け、どの部品がどれを使うかを矢印で示す
// reference use: 使う場面：モジュールの分け方、どこに何を置くか
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 4.0, 112.0, 72.0, dash=Some("3 2"), width=1.0, color="#2563eb"))
  ignore(c.rect(10.0, 12.0, 30.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(25.0, 21.0, "Handler", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(46.0, 12.0, 30.0, 14.0, rx=2.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.text(61.0, 21.0, "Service", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(82.0, 12.0, 30.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(97.0, 21.0, "Client", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(46.0, 50.0, 30.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(61.0, 59.0, "Repo", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((40.0, 19.0), (46.0, 19.0), width=1.2, color="#2563eb")
  c.polygon([(46.0, 19.0), (42.0, 21.0), (42.0, 17.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((76.0, 19.0), (82.0, 19.0), width=1.2, color="#2563eb")
  c.polygon([(82.0, 19.0), (78.0, 21.0), (78.0, 17.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((61.0, 26.0), (61.0, 50.0), width=1.2, color="#2563eb")
  c.polygon([(61.0, 50.0), (59.0, 46.0), (63.0, 46.0)], width=1.0, color="#2563eb", fill="#2563eb")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Component diagram"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
