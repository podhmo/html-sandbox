---
import { "podhmo/svg-gen" @svg }
---

// business/016 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((10.0, 15.0), (112.0, 15.0), color="#d5dae2")
  ignore(c.circle(29.0, 15.0, 3.0, width=1.0, color="#c2410c", fill="#c2410c"))
  ignore(c.circle(75.0, 15.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(97.0, 15.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(65.0, 15.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(85.0, 15.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((10.0, 35.0), (112.0, 35.0), color="#d5dae2")
  ignore(c.circle(79.0, 35.0, 3.0, width=1.0, color="#c2410c", fill="#c2410c"))
  ignore(c.circle(21.0, 35.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(87.0, 35.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(71.0, 35.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(44.0, 35.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((10.0, 55.0), (112.0, 55.0), color="#d5dae2")
  ignore(c.circle(18.0, 55.0, 3.0, width=1.0, color="#c2410c", fill="#c2410c"))
  ignore(c.circle(97.0, 55.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(60.0, 55.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(83.0, 55.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(98.0, 55.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Dot strip plot"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
