---
import { "podhmo/svg-gen" @svg }
---

// dev/023: Deployment diagram
// category: 配置
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：環境（本番、検証）の枠の中にサーバーやコンテナを入れ子にし、どこで何が動くかを描く
// reference use: 使う場面：環境ごとの構成の違い、配置先の説明
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 4.0, 112.0, 72.0, dash=Some("3 2"), width=1.0, color="#9aa4b5"))
  c.text(10.0, 12.0, "prod", anchor=@svg.Start, size=6.0, color="#5d6778")
  ignore(c.rect(10.0, 16.0, 46.0, 54.0, width=1.0, color="#2563eb"))
  ignore(c.rect(64.0, 16.0, 46.0, 54.0, width=1.0, color="#2563eb"))
  ignore(c.rect(16.0, 26.0, 34.0, 14.0, rx=2.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.text(33.0, 35.0, "API", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(16.0, 48.0, 34.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(33.0, 57.0, "Worker", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(70.0, 26.0, 34.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(87.0, 35.0, "DB", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((50.0, 33.0), (70.0, 33.0), width=1.2, color="#2563eb")
  c.polygon([(70.0, 33.0), (66.0, 35.0), (66.0, 31.0)], width=1.0, color="#2563eb", fill="#2563eb")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Deployment diagram"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
