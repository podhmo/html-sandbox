---
import { "podhmo/svg-gen" @svg }
---

// dev/031 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(2.0, 6.0, 36.0, 68.0, width=1.0, color="#d5dae2"))
  ignore(c.rect(8.0, 12.0, 24.0, 10.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(8.0, 52.0, 24.0, 10.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(42.0, 6.0, 36.0, 68.0, width=1.0, color="#d5dae2"))
  ignore(c.rect(48.0, 12.0, 24.0, 10.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(48.0, 32.0, 24.0, 10.0, rx=2.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.line((60.0, 22.0), (60.0, 32.0), width=1.2, color="#2563eb")
  c.polygon([(60.0, 32.0), (58.0, 28.0), (62.0, 28.0)], width=1.0, color="#2563eb", fill="#2563eb")
  ignore(c.rect(48.0, 52.0, 24.0, 10.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(82.0, 6.0, 36.0, 68.0, width=1.0, color="#d5dae2"))
  ignore(c.rect(88.0, 12.0, 24.0, 10.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(88.0, 32.0, 24.0, 10.0, rx=2.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.line((100.0, 22.0), (100.0, 32.0), width=1.2, color="#2563eb")
  c.polygon([(100.0, 32.0), (98.0, 28.0), (102.0, 28.0)], width=1.0, color="#2563eb", fill="#2563eb")
  ignore(c.rect(88.0, 52.0, 24.0, 10.0, dash=Some("3 2"), width=1.0, color="#c2410c"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("段階ごとの連作"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
