---
import { "podhmo/svg-gen" @svg }
---

// business/068: Basic choropleth
// category: 地理
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：地図の地域を、人口あたりのような率の濃さで塗る
// reference use: 使う場面：地域ごとの率
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(15.0, 8.0, 30.0, 22.0, width=1.0, color="#fff", fill="#eef3fd"))
  ignore(c.rect(45.0, 8.0, 30.0, 22.0, width=1.0, color="#fff", fill="#2563eb"))
  ignore(c.rect(75.0, 8.0, 30.0, 22.0, width=1.0, color="#fff", fill="#8db4f7"))
  ignore(c.rect(15.0, 30.0, 30.0, 22.0, width=1.0, color="#fff", fill="#c6d8fb"))
  ignore(c.rect(45.0, 30.0, 30.0, 22.0, width=1.0, color="#fff", fill="#eef3fd"))
  ignore(c.rect(75.0, 30.0, 30.0, 22.0, width=1.0, color="#fff", fill="#2563eb"))
  ignore(c.rect(15.0, 52.0, 30.0, 22.0, width=1.0, color="#fff", fill="#8db4f7"))
  ignore(c.rect(45.0, 52.0, 30.0, 22.0, width=1.0, color="#fff", fill="#c6d8fb"))
  ignore(c.rect(75.0, 52.0, 30.0, 22.0, width=1.0, color="#fff", fill="#eef3fd"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Basic choropleth"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
