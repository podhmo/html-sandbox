---
import { "podhmo/svg-gen" @svg }
---

// dev/026: 障害のタイムライン
// category: 時間
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：横に時刻を取り、検知、判断、緩和、復旧の出来事を印で置き、人とシステムで行を分ける
// reference use: 使う場面：障害の報告、振り返り
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((4.0, 74.0), (116.0, 74.0), width=1.0, color="#9aa4b5")
  c.polygon([(116.0, 74.0), (112.0, 76.0), (112.0, 72.0)], width=1.0, color="#9aa4b5", fill="#9aa4b5")
  c.line((4.0, 30.0), (116.0, 30.0), width=1.0, color="#d5dae2")
  c.line((4.0, 54.0), (116.0, 54.0), width=1.0, color="#d5dae2")
  ignore(c.circle(16.0, 18.0, 4.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.circle(40.0, 42.0, 4.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(62.0, 42.0, 4.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(78.0, 18.0, 4.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.circle(100.0, 42.0, 4.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(16.0, 14.0, 62.0, 8.0, dash=Some("3 2"), width=1.0, color="#c2410c"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("障害のタイムライン"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
