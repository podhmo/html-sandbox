---
import { "podhmo/svg-gen" @svg }
---

// dev/012: Event storming
// category: やりとり
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：時間の流れに沿って、出来事、それを起こす操作、受け持つ集約を色の違う付箋で左から右へ並べる
// reference use: 使う場面：業務の流れと、出来事の設計
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((4.0, 76.0), (116.0, 76.0), width=1.0, color="#9aa4b5")
  c.polygon([(116.0, 76.0), (112.0, 78.0), (112.0, 74.0)], width=1.0, color="#9aa4b5", fill="#9aa4b5")
  ignore(c.rect(6.0, 30.0, 18.0, 14.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(6.0, 10.0, 18.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(28.0, 30.0, 18.0, 14.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(28.0, 10.0, 18.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(50.0, 30.0, 18.0, 14.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(50.0, 10.0, 18.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(72.0, 30.0, 18.0, 14.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(72.0, 10.0, 18.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(94.0, 30.0, 18.0, 14.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(94.0, 10.0, 18.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(28.0, 52.0, 40.0, 12.0, width=1.0, color="#b59b00", fill="#fdf6c8"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Event storming"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
