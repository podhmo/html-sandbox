---
import { "podhmo/svg-gen" @svg }
---

// business/098: なぜの木
// category: 数が無い論点
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：上に課題を置き、下へ原因、さらに下へその原因と枝分かれさせる
// reference use: 使う場面：課題から原因へさかのぼる
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(45.0, 2.0, 30.0, 14.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  c.line((60.0, 16.0), (30.0, 30.0), color="#2563eb")
  c.line((60.0, 16.0), (90.0, 30.0), color="#2563eb")
  ignore(c.rect(15.0, 30.0, 30.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(75.0, 30.0, 30.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((30.0, 44.0), (30.0, 58.0), color="#2563eb")
  ignore(c.rect(15.0, 58.0, 30.0, 14.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("なぜの木"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
