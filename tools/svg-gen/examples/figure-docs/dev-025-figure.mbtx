---
import { "podhmo/svg-gen" @svg }
---

// dev/025 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 4.0, 36.0, 72.0, width=1.0, color="none", fill="#fbe9e0"))
  ignore(c.rect(42.0, 4.0, 36.0, 72.0, width=1.0, color="none", fill="#f6f2dc"))
  ignore(c.rect(80.0, 4.0, 36.0, 72.0, width=1.0, color="none", fill="#e6f4ea"))
  ignore(c.rect(10.0, 30.0, 24.0, 14.0, rx=2.0, width=1.0, color="#9aa4b5", fill="#d5dae2"))
  c.text(22.0, 39.0, "Client", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(46.0, 30.0, 26.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(59.0, 39.0, "LB", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(86.0, 18.0, 26.0, 14.0, rx=2.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.text(99.0, 27.0, "API", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(86.0, 46.0, 26.0, 14.0, rx=2.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.text(99.0, 55.0, "DB", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((34.0, 37.0), (46.0, 37.0), width=1.2, color="#2563eb")
  c.polygon([(46.0, 37.0), (42.0, 39.0), (42.0, 35.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((72.0, 34.0), (86.0, 26.0), width=1.2, color="#2563eb")
  c.polygon([(86.0, 26.0), (84.0, 29.0), (82.0, 26.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((99.0, 32.0), (99.0, 46.0), width=1.2, color="#2563eb")
  c.polygon([(99.0, 46.0), (97.0, 42.0), (101.0, 42.0)], width=1.0, color="#2563eb", fill="#2563eb")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("信頼の領域"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
