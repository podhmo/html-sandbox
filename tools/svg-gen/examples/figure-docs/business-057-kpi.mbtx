---
import { "podhmo/svg-gen" @svg }
---

// business/057: KPIツリー
// category: 内訳
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：上位の指標を式（売上＝客数×客単価）で分け、左から右へ枝分かれさせ、各指標に値と前の期との差を書く
// reference use: 使う場面：どの指標が全体の増減を生んだか
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 32.0, 26.0, 16.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((30.0, 40.0), (44.0, 20.0), color="#2563eb")
  c.line((30.0, 40.0), (44.0, 60.0), color="#2563eb")
  ignore(c.rect(44.0, 12.0, 26.0, 16.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(44.0, 52.0, 26.0, 16.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  c.line((70.0, 60.0), (84.0, 50.0), color="#2563eb")
  c.line((70.0, 60.0), (84.0, 72.0), color="#2563eb")
  ignore(c.rect(84.0, 43.0, 30.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(84.0, 65.0, 30.0, 12.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  c.text(37.0, 43.0, "×", anchor=@svg.Middle, size=8.0, color="#5d6778")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("KPIツリー"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
