  c.polyline([(10.0, 69.0), (14.0, 69.0), (18.0, 68.0), (22.0, 67.0), (26.0, 65.0), (30.0, 63.0), (34.0, 59.0), (38.0, 55.0), (42.0, 50.0), (46.0, 44.0), (50.0, 37.0), (54.0, 30.0), (58.0, 24.0), (62.0, 19.0), (66.0, 16.0), (70.0, 15.0), (74.0, 16.0), (78.0, 19.0), (82.0, 24.0), (86.0, 30.0), (90.0, 37.0), (94.0, 44.0), (98.0, 50.0), (102.0, 55.0), (106.0, 59.0), (110.0, 63.0)], color="#2563eb")
  c.polyline([(20.0, 78.0), (24.0, 77.0), (28.0, 77.0), (32.0, 75.0), (36.0, 73.0), (40.0, 70.0), (44.0, 66.0), (48.0, 61.0), (52.0, 56.0), (56.0, 50.0), (60.0, 45.0), (64.0, 41.0), (68.0, 40.0), (72.0, 41.0), (76.0, 45.0), (80.0, 50.0), (84.0, 56.0), (88.0, 61.0), (92.0, 66.0), (96.0, 70.0), (100.0, 73.0), (104.0, 75.0), (108.0, 77.0), (112.0, 77.0)], color="#15803d")
