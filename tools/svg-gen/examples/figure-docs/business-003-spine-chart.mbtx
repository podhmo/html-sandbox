---
import { "podhmo/svg-gen" @svg }
---

// business/003: Spine chart
// category: 差
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：1本の帯を中央の線で左右2つに分ける
// reference use: 使う場面：1つの値を対になる2つに分ける（男女など）
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((60.0, 4.0), (60.0, 76.0), color="#9aa4b5")
  ignore(c.rect(25.0, 10.0, 35.0, 12.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(60.0, 10.0, 25.0, 12.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(40.0, 30.0, 20.0, 12.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(60.0, 30.0, 40.0, 12.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(30.0, 50.0, 30.0, 12.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(60.0, 50.0, 30.0, 12.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Spine chart"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
