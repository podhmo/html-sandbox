---
import { "podhmo/svg-gen" @svg }
---

// business/007 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((10.0, 70.0), (112.0, 70.0), width=1.0, color="#9aa4b5")
  c.line((10.0, 6.0), (10.0, 70.0), width=1.0, color="#9aa4b5")
  ignore(c.circle(15.0, 61.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(21.0, 63.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(27.0, 57.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(33.0, 58.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(39.0, 56.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(45.0, 44.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(51.0, 40.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(57.0, 51.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(63.0, 39.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(69.0, 36.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(75.0, 45.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(81.0, 34.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(87.0, 37.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(93.0, 28.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(99.0, 28.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Scatterplot"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
