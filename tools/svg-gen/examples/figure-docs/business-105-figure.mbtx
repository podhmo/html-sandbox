---
import { "podhmo/svg-gen" @svg }
---

// business/105: 前と後を並べた図
// category: 数が無い論点
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：同じ配置の図を左右に並べ、変わる箇所にだけ印を付ける
// reference use: 使う場面：変更の前と後の違い
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(6.0, 12.0, 48.0, 56.0, width=1.0, color="#9aa4b5"))
  ignore(c.rect(66.0, 12.0, 48.0, 56.0, width=1.0, color="#9aa4b5"))
  ignore(c.rect(14.0, 22.0, 32.0, 10.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(74.0, 22.0, 32.0, 10.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(14.0, 44.0, 32.0, 10.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(74.0, 44.0, 32.0, 10.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  c.line((56.0, 40.0), (64.0, 40.0), color="#2563eb")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("前と後を並べた図"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
