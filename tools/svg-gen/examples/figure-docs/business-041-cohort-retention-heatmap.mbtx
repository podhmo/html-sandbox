---
import { "podhmo/svg-gen" @svg }
---

// business/041: Cohort retention heatmap
// category: 時間での変化
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：行に獲得した月、列に経過した月を取り、継続率をマスの濃さで塗る（右下が階段状に欠ける）
// reference use: 使う場面：継続率が獲得の時期でどう違うか（会員、サブスクリプション）
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(12.0, 6.0, 16.0, 13.0, width=1.0, color="#fff", fill="#2563eb"))
  ignore(c.rect(28.0, 6.0, 16.0, 13.0, width=1.0, color="#fff", fill="#5b8ef0"))
  ignore(c.rect(44.0, 6.0, 16.0, 13.0, width=1.0, color="#fff", fill="#8db4f7"))
  ignore(c.rect(60.0, 6.0, 16.0, 13.0, width=1.0, color="#fff", fill="#c6d8fb"))
  ignore(c.rect(76.0, 6.0, 16.0, 13.0, width=1.0, color="#fff", fill="#eef3fd"))
  ignore(c.rect(92.0, 6.0, 16.0, 13.0, width=1.0, color="#fff", fill="#eef3fd"))
  ignore(c.rect(12.0, 19.0, 16.0, 13.0, width=1.0, color="#fff", fill="#2563eb"))
  ignore(c.rect(28.0, 19.0, 16.0, 13.0, width=1.0, color="#fff", fill="#5b8ef0"))
  ignore(c.rect(44.0, 19.0, 16.0, 13.0, width=1.0, color="#fff", fill="#8db4f7"))
  ignore(c.rect(60.0, 19.0, 16.0, 13.0, width=1.0, color="#fff", fill="#c6d8fb"))
  ignore(c.rect(76.0, 19.0, 16.0, 13.0, width=1.0, color="#fff", fill="#eef3fd"))
  ignore(c.rect(12.0, 32.0, 16.0, 13.0, width=1.0, color="#fff", fill="#2563eb"))
  ignore(c.rect(28.0, 32.0, 16.0, 13.0, width=1.0, color="#fff", fill="#5b8ef0"))
  ignore(c.rect(44.0, 32.0, 16.0, 13.0, width=1.0, color="#fff", fill="#8db4f7"))
  ignore(c.rect(60.0, 32.0, 16.0, 13.0, width=1.0, color="#fff", fill="#c6d8fb"))
  ignore(c.rect(12.0, 45.0, 16.0, 13.0, width=1.0, color="#fff", fill="#2563eb"))
  ignore(c.rect(28.0, 45.0, 16.0, 13.0, width=1.0, color="#fff", fill="#5b8ef0"))
  ignore(c.rect(44.0, 45.0, 16.0, 13.0, width=1.0, color="#fff", fill="#8db4f7"))
  ignore(c.rect(12.0, 58.0, 16.0, 13.0, width=1.0, color="#fff", fill="#2563eb"))
  ignore(c.rect(28.0, 58.0, 16.0, 13.0, width=1.0, color="#fff", fill="#5b8ef0"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Cohort retention heatmap"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
