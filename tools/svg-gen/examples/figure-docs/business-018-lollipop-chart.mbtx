---
import { "podhmo/svg-gen" @svg }
---

// business/018: Lollipop chart
// category: 順位
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：細い線の先に点を付けた棒を大きい順に並べる
// reference use: 使う場面：棒の太さより値の位置に注目させたいとき
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((10.0, 12.0), (105.0, 12.0), color="#2563eb")
  ignore(c.circle(105.0, 12.0, 4.0, width=1.0, color="#2563eb", fill="#2563eb"))
  c.line((10.0, 26.0), (85.0, 26.0), color="#2563eb")
  ignore(c.circle(85.0, 26.0, 4.0, width=1.0, color="#2563eb", fill="#2563eb"))
  c.line((10.0, 40.0), (65.0, 40.0), color="#2563eb")
  ignore(c.circle(65.0, 40.0, 4.0, width=1.0, color="#2563eb", fill="#2563eb"))
  c.line((10.0, 54.0), (50.0, 54.0), color="#2563eb")
  ignore(c.circle(50.0, 54.0, 4.0, width=1.0, color="#2563eb", fill="#2563eb"))
  c.line((10.0, 68.0), (35.0, 68.0), color="#2563eb")
  ignore(c.circle(35.0, 68.0, 4.0, width=1.0, color="#2563eb", fill="#2563eb"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Lollipop chart"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
