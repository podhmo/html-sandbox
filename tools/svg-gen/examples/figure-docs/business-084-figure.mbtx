---
import { "podhmo/svg-gen" @svg }
---

// business/084 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 32.0, 22.0, 16.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((26.0, 40.0), (38.0, 14.0), color="#2563eb")
  c.line((26.0, 40.0), (38.0, 40.0), color="#2563eb")
  c.line((26.0, 40.0), (38.0, 66.0), color="#2563eb")
  ignore(c.rect(38.0, 7.0, 28.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(38.0, 33.0, 28.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(38.0, 59.0, 28.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((66.0, 14.0), (80.0, 6.0), color="#2563eb")
  c.line((66.0, 14.0), (80.0, 22.0), color="#2563eb")
  ignore(c.rect(80.0, 0.0, 30.0, 12.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(80.0, 17.0, 30.0, 12.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("ロジックツリー"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
