---
import { "podhmo/svg-gen" @svg }
---

// business/051: Voronoi
// category: 内訳
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：点ごとに、その点にいちばん近い範囲を多角形の面にする
// reference use: 使う場面：点の勢力圏や担当範囲
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.polygon([(8.0, 6.0), (55.0, 6.0), (45.0, 40.0), (8.0, 50.0)], width=1.0, color="#2563eb", fill="#dbe8fd")
  c.polygon([(55.0, 6.0), (112.0, 6.0), (112.0, 35.0), (45.0, 40.0)], width=1.0, color="#15803d", fill="#dcf3e3")
  c.polygon([(8.0, 50.0), (45.0, 40.0), (70.0, 74.0), (8.0, 74.0)], width=1.0, color="#c2410c", fill="#fde5d6")
  c.polygon([(45.0, 40.0), (112.0, 35.0), (112.0, 74.0), (70.0, 74.0)], width=1.0, color="#2563eb", fill="#c6d8fb")
  ignore(c.circle(28.0, 28.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(85.0, 20.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(30.0, 62.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(88.0, 55.0, 2.0, width=1.0, color="#2563eb", fill="#2563eb"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Voronoi"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
