---
import { "podhmo/svg-gen" @svg }
---

// business/006: Tornado chart
// category: 差
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：中央の基準値の線から、前提を低く・高く振ったときの結果の差を左右の横棒で描き、影響の大きい順に上から並べる
// reference use: 使う場面：どの前提が結果（利益、企業価値）に最も大きく影響するか
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((60.0, 4.0), (60.0, 76.0), color="#9aa4b5")
  ignore(c.rect(18.0, 6.0, 42.0, 10.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(60.0, 6.0, 38.0, 10.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(30.0, 20.0, 30.0, 10.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(60.0, 20.0, 34.0, 10.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(38.0, 34.0, 22.0, 10.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(60.0, 34.0, 18.0, 10.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(46.0, 48.0, 14.0, 10.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(60.0, 48.0, 12.0, 10.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(54.0, 62.0, 6.0, 10.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(60.0, 62.0, 8.0, 10.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Tornado chart"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
