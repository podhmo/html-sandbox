---
import { "podhmo/svg-gen" @svg }
---

// dev/001: System Context
// category: 構造
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：中央に対象のシステム、周りに利用者と外部システムを置き、やりとりする内容を書いた矢印で結ぶ
// reference use: 使う場面：設計書の冒頭、対象範囲の合意、非開発者への説明
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(42.0, 30.0, 36.0, 20.0, rx=2.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.text(60.0, 42.0, "本体", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.circle(16.0, 14.0, 7.0, width=1.0, color="#9aa4b5", fill="#d5dae2"))
  ignore(c.rect(4.0, 58.0, 28.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(18.0, 67.0, "外部", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(88.0, 6.0, 28.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(102.0, 15.0, "外部", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(88.0, 58.0, 28.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(102.0, 67.0, "外部", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((22.0, 19.0), (44.0, 32.0), width=1.2, color="#2563eb")
  c.polygon([(44.0, 32.0), (40.0, 32.0), (42.0, 29.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((78.0, 34.0), (90.0, 20.0), width=1.2, color="#2563eb")
  c.polygon([(90.0, 20.0), (89.0, 24.0), (86.0, 22.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((78.0, 46.0), (90.0, 60.0), width=1.2, color="#2563eb")
  c.polygon([(90.0, 60.0), (86.0, 58.0), (89.0, 56.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((42.0, 46.0), (32.0, 60.0), width=1.2, color="#2563eb")
  c.polygon([(32.0, 60.0), (33.0, 56.0), (36.0, 58.0)], width=1.0, color="#2563eb", fill="#2563eb")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("System Context"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
