---
import { "podhmo/svg-gen" @svg }
---

// business/079 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((25.0, 20.0), (60.0, 40.0), width=3.0, color="#2563eb")
  c.line((60.0, 40.0), (95.0, 18.0), width=1.0, color="#2563eb")
  c.line((60.0, 40.0), (90.0, 62.0), width=2.0, color="#2563eb")
  c.line((25.0, 20.0), (30.0, 62.0), width=1.0, color="#9aa4b5")
  c.line((30.0, 62.0), (60.0, 40.0), width=1.0, color="#2563eb")
  ignore(c.circle(25.0, 20.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(60.0, 40.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(95.0, 18.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(90.0, 62.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(30.0, 62.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Network"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
