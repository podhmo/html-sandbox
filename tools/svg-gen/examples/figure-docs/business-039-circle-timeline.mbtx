---
import { "podhmo/svg-gen" @svg }
---

// business/039: Circle timeline
// category: 時間での変化
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：分類ごとの時間の線に、出来事を大きさの違う円で置く
// reference use: 使う場面：分類ごとに規模の異なる出来事がいつ起きたか
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((10.0, 15.0), (112.0, 15.0), color="#d5dae2")
  ignore(c.circle(20.0, 15.0, 2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(42.0, 15.0, 5.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(64.0, 15.0, 8.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(86.0, 15.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(108.0, 15.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((10.0, 37.0), (112.0, 37.0), color="#d5dae2")
  ignore(c.circle(20.0, 37.0, 5.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(42.0, 37.0, 8.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(64.0, 37.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(86.0, 37.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(108.0, 37.0, 9.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((10.0, 59.0), (112.0, 59.0), color="#d5dae2")
  ignore(c.circle(20.0, 59.0, 8.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(42.0, 59.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(64.0, 59.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(86.0, 59.0, 9.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(108.0, 59.0, 4.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Circle timeline"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
