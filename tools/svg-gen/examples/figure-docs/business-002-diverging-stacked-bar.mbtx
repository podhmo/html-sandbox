---
import { "podhmo/svg-gen" @svg }
---

// business/002: Diverging stacked bar
// category: 差
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：中立を中央に置き、賛成を右、反対を左に積む
// reference use: 使う場面：賛成・中立・反対のような両極のある回答
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((60.0, 4.0), (60.0, 76.0), color="#9aa4b5")
  ignore(c.rect(33.0, 10.0, 20.0, 12.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(53.0, 10.0, 14.0, 12.0, width=1.0, color="#9aa4b5", fill="#d5dae2"))
  ignore(c.rect(67.0, 10.0, 30.0, 12.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(25.0, 30.0, 30.0, 12.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(55.0, 30.0, 10.0, 12.0, width=1.0, color="#9aa4b5", fill="#d5dae2"))
  ignore(c.rect(65.0, 30.0, 15.0, 12.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(38.0, 50.0, 12.0, 12.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.rect(50.0, 50.0, 20.0, 12.0, width=1.0, color="#9aa4b5", fill="#d5dae2"))
  ignore(c.rect(70.0, 50.0, 40.0, 12.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Diverging stacked bar"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
