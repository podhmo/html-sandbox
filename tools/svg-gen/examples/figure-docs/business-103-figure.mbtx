---
import { "podhmo/svg-gen" @svg }
---

// business/103: 判断の木
// category: 数が無い論点
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：条件をひし形、結果を四角にして枝分かれさせる
// reference use: 使う場面：条件で分かれる道と、それぞれの結果
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 32.0, 22.0, 16.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((26.0, 40.0), (46.0, 18.0), color="#2563eb")
  c.line((26.0, 40.0), (46.0, 62.0), color="#2563eb")
  c.polygon([(58.0, 10.0), (70.0, 18.0), (58.0, 26.0), (46.0, 18.0)], width=1.0, color="#15803d", fill="#dcf3e3")
  ignore(c.rect(46.0, 55.0, 24.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((70.0, 18.0), (88.0, 18.0), color="#2563eb")
  ignore(c.rect(88.0, 11.0, 24.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("判断の木"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
