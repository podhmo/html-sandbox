---
import { "podhmo/svg-gen" @svg }
---

// dev/010: Sequence diagram
// category: やりとり
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：参加者ごとの縦の線を並べ、呼び出しを実線、応答を点線の横向きの矢印で上から順に描き、分岐や繰り返しは枠で囲む
// reference use: 使う場面：API の呼び出しの順、失敗したときの動き
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 2.0, 32.0, 10.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(20.0, 9.0, "User", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((20.0, 12.0), (20.0, 78.0), dash=Some("3 2"), width=1.0, color="#9aa4b5")
  ignore(c.rect(44.0, 2.0, 32.0, 10.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(60.0, 9.0, "API", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((60.0, 12.0), (60.0, 78.0), dash=Some("3 2"), width=1.0, color="#9aa4b5")
  ignore(c.rect(84.0, 2.0, 32.0, 10.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(100.0, 9.0, "DB", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((100.0, 12.0), (100.0, 78.0), dash=Some("3 2"), width=1.0, color="#9aa4b5")
  c.line((20.0, 22.0), (60.0, 22.0), width=1.2, color="#2563eb")
  c.polygon([(60.0, 22.0), (56.0, 24.0), (56.0, 20.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((60.0, 34.0), (100.0, 34.0), width=1.2, color="#2563eb")
  c.polygon([(100.0, 34.0), (96.0, 36.0), (96.0, 32.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((100.0, 44.0), (60.0, 44.0), dash=Some("3 2"), width=1.0, color="#2563eb")
  c.polygon([(60.0, 44.0), (64.0, 42.0), (64.0, 46.0)], width=1.0, color="#2563eb", fill="#2563eb")
  ignore(c.rect(14.0, 50.0, 92.0, 24.0, dash=Some("3 2"), width=1.0, color="#c2410c"))
  c.text(22.0, 57.0, "alt", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((60.0, 66.0), (20.0, 66.0), dash=Some("3 2"), width=1.0, color="#c2410c")
  c.polygon([(20.0, 66.0), (24.0, 64.0), (24.0, 68.0)], width=1.0, color="#c2410c", fill="#c2410c")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Sequence diagram"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
