// business/111 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 4.0, 22.0, 50.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(26.0, 4.0, 22.0, 25.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(26.0, 29.0, 22.0, 25.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(48.0, 4.0, 24.0, 50.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(72.0, 4.0, 22.0, 25.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(72.0, 29.0, 22.0, 25.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(94.0, 4.0, 22.0, 50.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(4.0, 54.0, 56.0, 22.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(60.0, 54.0, 56.0, 22.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(48.0, 4.0, 24.0, 50.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("ビジネスモデルキャンバス"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
