---
import { "podhmo/svg-gen" @svg }
---

// dev/007: Context Map
// category: 構造
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：業務の境界（Bounded Context）を円にし、上流と下流、変換の層（ACL）などの関係を線に書く
// reference use: 使う場面：チームとサービスの境界、連携方針の整理
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.circle(26.0, 26.0, 18.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.circle(92.0, 26.0, 18.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(60.0, 62.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((44.0, 26.0), (74.0, 26.0), color="#2563eb")
  c.text(59.0, 22.0, "U → D", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(70.0, 20.0, 6.0, 12.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  c.line((36.0, 40.0), (50.0, 54.0), color="#2563eb")
  c.text(60.0, 64.0, "", anchor=@svg.Middle, size=6.0, color="#5d6778")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Context Map"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
