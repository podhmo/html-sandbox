---
import { "podhmo/svg-gen" @svg }
---

// dev/016: Screen flow
// category: 状態と手順
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：画面を小さな四角、操作を矢印にして、画面の行き来を描く
// reference use: 使う場面：画面の構成と、利用者がたどる道
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(6.0, 26.0, 20.0, 28.0, rx=2.0, width=1.0, color="#2563eb", fill="#fff"))
  ignore(c.rect(8.0, 29.0, 16.0, 3.0, width=1.0, color="none", fill="#dbe8fd"))
  ignore(c.rect(48.0, 6.0, 20.0, 28.0, rx=2.0, width=1.0, color="#2563eb", fill="#fff"))
  ignore(c.rect(50.0, 9.0, 16.0, 3.0, width=1.0, color="none", fill="#dbe8fd"))
  ignore(c.rect(48.0, 46.0, 20.0, 28.0, rx=2.0, width=1.0, color="#2563eb", fill="#fff"))
  ignore(c.rect(50.0, 49.0, 16.0, 3.0, width=1.0, color="none", fill="#dbe8fd"))
  ignore(c.rect(92.0, 26.0, 20.0, 28.0, rx=2.0, width=1.0, color="#2563eb", fill="#fff"))
  ignore(c.rect(94.0, 29.0, 16.0, 3.0, width=1.0, color="none", fill="#dbe8fd"))
  c.line((26.0, 36.0), (48.0, 20.0), width=1.2, color="#2563eb")
  c.polygon([(48.0, 20.0), (46.0, 24.0), (44.0, 21.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((26.0, 46.0), (48.0, 58.0), width=1.2, color="#2563eb")
  c.polygon([(48.0, 58.0), (44.0, 58.0), (46.0, 55.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((68.0, 20.0), (92.0, 36.0), width=1.2, color="#2563eb")
  c.polygon([(92.0, 36.0), (88.0, 35.0), (90.0, 33.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((68.0, 60.0), (92.0, 46.0), width=1.2, color="#2563eb")
  c.polygon([(92.0, 46.0), (90.0, 49.0), (88.0, 46.0)], width=1.0, color="#2563eb", fill="#2563eb")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Screen flow"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
