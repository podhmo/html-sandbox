---
import { "podhmo/svg-gen" @svg }
---

// business/104: 案の比較表
// category: 数が無い論点
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：行に案、列に観点を取り、マスに評価を書き、推す案に印を付ける
// reference use: 使う場面：案ごとの長所と短所
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(10.0, 8.0, 32.0, 18.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(10.0, 28.0, 32.0, 18.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(10.0, 48.0, 32.0, 18.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(44.0, 8.0, 32.0, 18.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(44.0, 28.0, 32.0, 18.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(44.0, 48.0, 32.0, 18.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(78.0, 8.0, 32.0, 18.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  ignore(c.rect(78.0, 28.0, 32.0, 18.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(78.0, 48.0, 32.0, 18.0, width=1.0, color="#9aa4b5", fill="#f8f9fb"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("案の比較表"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
