---
import { "podhmo/svg-gen" @svg }
---

// dev/006: Class diagram
// category: 構造
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：型を3つに区切った四角（名前、属性、操作）にし、継承は白い三角の矢印、関連は線と数で結ぶ
// reference use: 使う場面：ドメインのモデル、型の設計
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(8.0, 8.0, 32.0, 30.0, width=1.0, color="#2563eb", fill="#fff"))
  c.line((8.0, 16.0), (40.0, 16.0), width=1.0, color="#2563eb")
  c.line((8.0, 28.0), (40.0, 28.0), width=1.0, color="#2563eb")
  c.text(24.0, 14.0, "Order", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(80.0, 8.0, 32.0, 30.0, width=1.0, color="#2563eb", fill="#fff"))
  c.line((80.0, 16.0), (112.0, 16.0), width=1.0, color="#2563eb")
  c.line((80.0, 28.0), (112.0, 28.0), width=1.0, color="#2563eb")
  c.text(96.0, 14.0, "Item", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((40.0, 22.0), (80.0, 22.0), color="#2563eb")
  c.text(46.0, 20.0, "1", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.text(74.0, 20.0, "*", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(8.0, 52.0, 32.0, 20.0, width=1.0, color="#2563eb", fill="#fff"))
  c.text(24.0, 64.0, "Paid", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((24.0, 52.0), (24.0, 42.0), color="#2563eb")
  c.polygon([(24.0, 38.0), (20.0, 44.0), (28.0, 44.0)], width=1.0, color="#2563eb", fill="#fff")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Class diagram"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
