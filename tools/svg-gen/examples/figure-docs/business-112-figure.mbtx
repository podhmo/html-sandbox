  ignore(c.circle(58.0, 54.0, 6.0, width=1.0, color="#9aa4b5", fill="#fff"))
  ignore(c.circle(58.0, 54.0, 6.0, width=1.0, color="#2563eb", fill="#2563eb"))
  ignore(c.circle(58.0, 74.0, 6.0, width=1.0, color="#9aa4b5", fill="#fff"))
  ignore(c.circle(84.0, 14.0, 6.0, width=1.0, color="#9aa4b5", fill="#fff"))
  ignore(c.circle(84.0, 14.0, 6.0, width=1.0, color="#2563eb", fill="#2563eb"))
