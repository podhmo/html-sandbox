  ignore(c.circle(110.0, 14.0, 6.0, width=1.0, color="#9aa4b5", fill="#fff"))
  c.path("M110,14 L110,8 A6,6 0 0,1 116.0,14.0 Z", [], width=1.0, color="none", fill="#2563eb")
  ignore(c.circle(110.0, 34.0, 6.0, width=1.0, color="#9aa4b5", fill="#fff"))
