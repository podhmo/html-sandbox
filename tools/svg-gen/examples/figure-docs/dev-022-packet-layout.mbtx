---
import { "podhmo/svg-gen" @svg }
---

// dev/022: Packet layout
// category: データ
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：ビットの幅に合わせた横長の枠に、項目を区切って並べる
// reference use: 使う場面：通信やファイルの形式
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 8.0, 28.0, 16.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(32.0, 8.0, 28.0, 16.0, width=1.0, color="#2563eb", fill="#dcf3e3"))
  ignore(c.rect(60.0, 8.0, 56.0, 16.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(4.0, 26.0, 112.0, 16.0, width=1.0, color="#2563eb", fill="#d5dae2"))
  c.text(18.0, 18.0, "ver", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.text(46.0, 18.0, "type", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.text(88.0, 18.0, "length", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.text(60.0, 36.0, "payload", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.text(4.0, 62.0, "0", anchor=@svg.Start, size=6.0, color="#5d6778")
  c.text(32.0, 62.0, "8", anchor=@svg.Start, size=6.0, color="#5d6778")
  c.text(60.0, 62.0, "16", anchor=@svg.Start, size=6.0, color="#5d6778")
  c.text(88.0, 62.0, "24", anchor=@svg.Start, size=6.0, color="#5d6778")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Packet layout"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
