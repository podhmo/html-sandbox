---
import { "podhmo/svg-gen" @svg }
---

// dev/029: リリースの計画
// category: 時間
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：作業ごとの期間の帯と節目の印を、時間軸に沿って置く
// reference use: 使う場面：段階的な導入の計画
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((8.0, 74.0), (112.0, 74.0), color="#9aa4b5")
  ignore(c.rect(10.0, 8.0, 40.0, 10.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(36.0, 24.0, 46.0, 10.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(60.0, 40.0, 30.0, 10.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.polygon([(96.0, 52.0), (100.0, 56.0), (96.0, 60.0), (92.0, 56.0)], width=1.0, color="#c2410c", fill="#c2410c")
  c.line((96.0, 4.0), (96.0, 74.0), dash=Some("3 2"), width=1.0, color="#c2410c")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("リリースの計画"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
