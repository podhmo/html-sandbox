---
import { "podhmo/svg-gen" @svg }
---

// business/067: Parallel coordinates
// category: 大きさ
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：項目ごとの縦軸を横に並べ、1件を軸をまたぐ折れ線で描く
// reference use: 使う場面：多くの指標を持つ複数データの比較
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((15.0, 6.0), (15.0, 74.0), width=1.0, color="#9aa4b5")
  c.line((37.0, 6.0), (37.0, 74.0), width=1.0, color="#9aa4b5")
  c.line((59.0, 6.0), (59.0, 74.0), width=1.0, color="#9aa4b5")
  c.line((81.0, 6.0), (81.0, 74.0), width=1.0, color="#9aa4b5")
  c.line((103.0, 6.0), (103.0, 74.0), width=1.0, color="#9aa4b5")
  c.polyline([(15.0, 20.0), (37.0, 50.0), (59.0, 30.0), (81.0, 60.0), (103.0, 25.0)], color="#2563eb")
  c.polyline([(15.0, 55.0), (37.0, 25.0), (59.0, 45.0), (81.0, 20.0), (103.0, 50.0)], color="#c2410c")
  c.polyline([(15.0, 40.0), (37.0, 40.0), (59.0, 15.0), (81.0, 40.0), (103.0, 65.0)], color="#15803d")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Parallel coordinates"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
