---
import { "podhmo/svg-gen" @svg }
---

// business/061: Paired bar
// category: 大きさ
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：項目ごとに2系列の横棒を並べる
// reference use: 使う場面：名前の長い2系列の比較
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(10.0, 6.0, 80.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(10.0, 12.0, 60.0, 6.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(10.0, 20.0, 95.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(10.0, 26.0, 70.0, 6.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(10.0, 34.0, 50.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(10.0, 40.0, 65.0, 6.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(10.0, 48.0, 40.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(10.0, 54.0, 30.0, 6.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.rect(10.0, 62.0, 70.0, 6.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(10.0, 68.0, 85.0, 6.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Paired bar"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
