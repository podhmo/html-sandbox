---
import { "podhmo/svg-gen" @svg }
---

// dev/020 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 32.0, 22.0, 16.0, rx=2.0, width=1.0, color="#9aa4b5", fill="#d5dae2"))
  c.text(15.0, 42.0, "User", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((36.0, 4.0), (36.0, 76.0), dash=Some("3 2"), color="#c2410c")
  ignore(c.circle(60.0, 40.0, 12.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.line((92.0, 30.0), (116.0, 30.0), color="#2563eb")
  c.line((92.0, 42.0), (116.0, 42.0), color="#2563eb")
  c.line((26.0, 40.0), (48.0, 40.0), width=1.2, color="#2563eb")
  c.polygon([(48.0, 40.0), (44.0, 42.0), (44.0, 38.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((72.0, 40.0), (92.0, 36.0), width=1.2, color="#2563eb")
  c.polygon([(92.0, 36.0), (89.0, 38.0), (88.0, 35.0)], width=1.0, color="#2563eb", fill="#2563eb")
  ignore(c.circle(36.0, 34.0, 4.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  c.text(36.0, 36.0, "!", anchor=@svg.Middle, size=6.0, color="#5d6778")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("脅威モデルの DFD"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
