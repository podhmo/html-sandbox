---
import { "podhmo/svg-gen" @svg }
---

// dev/030 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(2.0, 4.0, 54.0, 72.0, width=1.0, color="#d5dae2"))
  ignore(c.rect(64.0, 4.0, 54.0, 72.0, width=1.0, color="#d5dae2"))
  ignore(c.rect(8.0, 10.0, 20.0, 12.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(30.0, 40.0, 20.0, 12.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.line((18.0, 22.0), (36.0, 40.0), width=1.2, color="#2563eb")
  c.polygon([(36.0, 40.0), (32.0, 39.0), (35.0, 36.0)], width=1.0, color="#2563eb", fill="#2563eb")
  ignore(c.rect(70.0, 10.0, 20.0, 12.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(92.0, 40.0, 20.0, 12.0, dash=Some("3 2"), width=1.0, color="#c2410c"))
  ignore(c.rect(70.0, 40.0, 20.0, 12.0, rx=2.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.line((80.0, 22.0), (80.0, 40.0), width=2.4, color="#2563eb")
  c.polygon([(80.0, 40.0), (78.0, 36.0), (82.0, 36.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((57.0, 40.0), (63.0, 40.0), width=1.2, color="#9aa4b5")
  c.polygon([(63.0, 40.0), (59.0, 42.0), (59.0, 38.0)], width=1.0, color="#9aa4b5", fill="#9aa4b5")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("変更の前と後"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
