---
import { "podhmo/svg-gen" @svg }
---

// business/085: ピラミッド
// category: 数が無い論点
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：頂点に結論、その下に根拠、さらに下に事実を置く階層図
// reference use: 使う場面：結論と根拠の組み立て
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(42.0, 4.0, 36.0, 14.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.line((60.0, 18.0), (25.0, 30.0), color="#2563eb")
  c.line((60.0, 18.0), (60.0, 30.0), color="#2563eb")
  c.line((60.0, 18.0), (95.0, 30.0), color="#2563eb")
  ignore(c.rect(10.0, 30.0, 30.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(45.0, 30.0, 30.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(80.0, 30.0, 30.0, 14.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(8.0, 56.0, 11.0, 12.0, width=1.0, color="#9aa4b5", fill="#f1f3f6"))
  ignore(c.rect(21.0, 56.0, 11.0, 12.0, width=1.0, color="#9aa4b5", fill="#f1f3f6"))
  ignore(c.rect(34.0, 56.0, 11.0, 12.0, width=1.0, color="#9aa4b5", fill="#f1f3f6"))
  ignore(c.rect(47.0, 56.0, 11.0, 12.0, width=1.0, color="#9aa4b5", fill="#f1f3f6"))
  ignore(c.rect(60.0, 56.0, 11.0, 12.0, width=1.0, color="#9aa4b5", fill="#f1f3f6"))
  ignore(c.rect(73.0, 56.0, 11.0, 12.0, width=1.0, color="#9aa4b5", fill="#f1f3f6"))
  ignore(c.rect(86.0, 56.0, 11.0, 12.0, width=1.0, color="#9aa4b5", fill="#f1f3f6"))
  ignore(c.rect(99.0, 56.0, 11.0, 12.0, width=1.0, color="#9aa4b5", fill="#f1f3f6"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("ピラミッド"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
