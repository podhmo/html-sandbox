---
import { "podhmo/svg-gen" @svg }
---

// business/065 transcription probe
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away. The
// reference name is kept as string data in the render label.

fn main {
  let c = @svg.Canvas(margin=0.0)
  c.line((18.0, 70.0), (18.0, 30.0), color="#2563eb")
  ignore(c.circle(18.0, 30.0, 4.0, width=1.0, color="#2563eb", fill="#2563eb"))
  c.line((38.0, 70.0), (38.0, 15.0), color="#2563eb")
  ignore(c.circle(38.0, 15.0, 4.0, width=1.0, color="#2563eb", fill="#2563eb"))
  c.line((58.0, 70.0), (58.0, 40.0), color="#2563eb")
  ignore(c.circle(58.0, 40.0, 4.0, width=1.0, color="#2563eb", fill="#2563eb"))
  c.line((78.0, 70.0), (78.0, 22.0), color="#2563eb")
  ignore(c.circle(78.0, 22.0, 4.0, width=1.0, color="#2563eb", fill="#2563eb"))
  c.line((98.0, 70.0), (98.0, 45.0), color="#2563eb")
  ignore(c.circle(98.0, 45.0, 4.0, width=1.0, color="#2563eb", fill="#2563eb"))
  c.line((10.0, 70.0), (112.0, 70.0), color="#9aa4b5")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Lollipop chart"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
