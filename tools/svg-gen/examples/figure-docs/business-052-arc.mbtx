  ignore(c.circle(77.0, 28.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(69.0, 26.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(60.0, 25.0, 3.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.circle(51.0, 26.0, 3.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.circle(43.0, 28.0, 3.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.circle(35.0, 33.0, 3.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.circle(28.0, 38.0, 3.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.circle(23.0, 45.0, 3.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  ignore(c.circle(18.0, 53.0, 3.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.circle(16.0, 61.0, 3.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  ignore(c.circle(15.0, 70.0, 3.0, width=1.0, color="#c2410c", fill="#fde5d6"))
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Arc"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
