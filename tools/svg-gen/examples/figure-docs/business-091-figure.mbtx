---
import { "podhmo/svg-gen" @svg }
---

// business/091: スイムレーン
// category: 数が無い論点
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/business.html
// reference shape: 形：人や部門ごとの横の帯の中に作業を置き、順に矢印で結ぶ
// reference use: 使う場面：誰が、どの順で、何をするか
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(4.0, 4.0, 112.0, 22.0, width=1.0, color="#9aa4b5"))
  ignore(c.rect(4.0, 28.0, 112.0, 22.0, width=1.0, color="#9aa4b5"))
  ignore(c.rect(4.0, 52.0, 112.0, 22.0, width=1.0, color="#9aa4b5"))
  ignore(c.rect(20.0, 9.0, 22.0, 12.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(50.0, 33.0, 22.0, 12.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  ignore(c.rect(84.0, 57.0, 22.0, 12.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.line((42.0, 15.0), (50.0, 39.0), width=1.0, color="#2563eb")
  c.line((72.0, 39.0), (84.0, 63.0), width=1.0, color="#2563eb")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("スイムレーン"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
