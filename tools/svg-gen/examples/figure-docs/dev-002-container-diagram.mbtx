---
import { "podhmo/svg-gen" @svg }
---

// dev/002: Container diagram
// category: 構造
// source: https://raw.githubusercontent.com/u-ichi/agent-plugins/c10dce225fe205bdacb64f754cc5b6fc61ead8f2/plugins/figure-docs/skills/figure-docs/references/dev.html
// reference shape: 形：実行する単位（Web、API、DB、キュー）を四角にし、通信の向きと方式（HTTPS、SQL）を矢印に書く
// reference use: 使う場面：全体の構成、変更が及ぶ範囲
//
// Mechanical transcription probe: each SVG element in the reference is
// emitted through the lowest-level svg-gen primitive that can represent
// it. Coordinates and fixed light-theme colors are intentionally kept so
// unsupported surface area is visible instead of redesigned away.

fn main {
  let c = @svg.Canvas(margin=0.0)
  ignore(c.rect(2.0, 2.0, 116.0, 76.0, dash=Some("3 2"), width=1.0, color="#9aa4b5"))
  ignore(c.rect(8.0, 10.0, 28.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(22.0, 19.0, "Web", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(46.0, 10.0, 28.0, 14.0, rx=2.0, width=1.0, color="#15803d", fill="#dcf3e3"))
  c.text(60.0, 19.0, "API", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(84.0, 10.0, 28.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(98.0, 19.0, "Worker", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(46.0, 52.0, 28.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(60.0, 61.0, "DB", anchor=@svg.Middle, size=6.0, color="#5d6778")
  ignore(c.rect(84.0, 52.0, 28.0, 14.0, rx=2.0, width=1.0, color="#2563eb", fill="#dbe8fd"))
  c.text(98.0, 61.0, "Queue", anchor=@svg.Middle, size=6.0, color="#5d6778")
  c.line((36.0, 17.0), (46.0, 17.0), width=1.2, color="#2563eb")
  c.polygon([(46.0, 17.0), (42.0, 19.0), (42.0, 15.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((60.0, 24.0), (60.0, 52.0), width=1.2, color="#2563eb")
  c.polygon([(60.0, 52.0), (58.0, 48.0), (62.0, 48.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((74.0, 22.0), (90.0, 52.0), width=1.2, color="#2563eb")
  c.polygon([(90.0, 52.0), (87.0, 50.0), (90.0, 48.0)], width=1.0, color="#2563eb", fill="#2563eb")
  c.line((98.0, 52.0), (98.0, 24.0), width=1.2, color="#2563eb")
  c.polygon([(98.0, 24.0), (100.0, 28.0), (96.0, 28.0)], width=1.0, color="#2563eb", fill="#2563eb")
  println(
    c.render(
      width=Some(120.0),
      height=Some(80.0),
      label=Some("Container diagram"),
      viewbox=Some(@svg.ViewBox::{ x: 0.0, y: 0.0, w: 120.0, h: 80.0 }),
    ),
  )
}
