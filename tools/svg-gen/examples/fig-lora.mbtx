---
import { "podhmo/svg-gen" @s }
---

// fig-lora.mbtx -- what a LoRA is: the base model's weight matrix W
// stays frozen while a small low-rank delta (B x A, rank r) is
// trained on the 74-image DADS dataset and later merged at
// inference time behind a trigger word. Schematic, not measured.

fn main {
  let c = @s.Canvas::new(margin=12.0)

  // the frozen base: one large matrix block
  let base = c.box(30.0, 60.0, @s.Fixed(190.0), 140.0, label="base model W\n(凍結)", color=c.color(0))
  c.text(125.0, 215.0, "数GB・学習しない", anchor=@s.Middle, size=11.0, opacity=Some(0.7))

  // the adapter: two thin matrices B and A (low rank)
  let b_mat = c.box(270.0, 80.0, @s.Fixed(26.0), 100.0, label="B", color=c.color(2), size=12.0)
  let a_mat = c.box(310.0, 150.0, @s.Fixed(100.0), 26.0, label="A", color=c.color(3), size=12.0)
  c.text(370.0, 120.0, "ΔW = B·A\nrank r (16程度)\n数十MB", size=11.0)

  // merge arrow into output
  let out = c.box(520.0, 80.0, @s.Auto, 44.0, label="生成時に\nW + ΔW", color=c.color(1))
  c.arrow(c.anchor(base, @s.E), c.anchor(out, @s.W), via=[(240.0, 82.0)])
  c.arrow((296.0, 130.0), c.anchor(out, @s.S), dash="4 4")

  // trigger word activates the delta
  c.text(520.0, 170.0, "prompt:", size=11.0, opacity=Some(0.7))
  c.text(520.0, 186.0, "dadsillu, a person ...", size=12.0, underline=1.0)

  if !(base.w > a_mat.w + b_mat.w) {
    abort("the delta is drawn much smaller than the base")
  }
  println(
    c.render(label="schematic of a LoRA: a frozen base weight W plus a small low-rank delta B times A merged at inference"),
  )
}
