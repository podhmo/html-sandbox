---
import { "podhmo/svg-gen" @svg }
---

// fig-mwg-funnel.mbtx -- Picking TODO tasks from the
// modern-web-guidance catalog: 208 guides pass three filters
// (needs executable JS? does the app even have that UI? is the
// gap real?), leaving 10 tasks. Counts of the dropped side are
// schematic — only 208 and 10 are real numbers.

fn main {
  let c = @svg.Canvas()

  let src = c.box(
    0.0,
    40.0,
    @svg.Auto,
    60.0,
    label=Some("208 guides\nmodern-web-guidance list"),
    width=2.0,
  )

  // Three filter gates in a row; each drops a class of guides
  // downward.
  let gate = fn(x : Double, y : Double, label : String, col : Int) -> @svg.Shape {
    c.box(x, y, @svg.Auto, 56.0, label=Some(label), color=c.color(col), width=2.0)
  }

  let g1 = gate(260.0, 42.0, "executable JS?\nJS API 前提は除外", 0)
  let g2 = gate(450.0, 42.0, "対象の UI が\nアプリにある?", 1)
  let g3 = gate(640.0, 42.0, "現状に明確な\n不足がある?", 4)

  let out = c.box(
    800.0,
    40.0,
    @svg.Auto,
    60.0,
    label=Some("10 tasks\n採用 9 + 判断留保 1"),
    color=c.color(2),
    width=2.5,
  )

  // Flow arrows through the gates.
  c.arrow(c.anchor(src, @svg.E), c.anchor(g1, @svg.W))
  c.arrow(c.anchor(g1, @svg.E), c.anchor(g2, @svg.W))
  c.arrow(c.anchor(g2, @svg.E), c.anchor(g3, @svg.W))
  c.arrow(c.anchor(g3, @svg.E), c.anchor(out, @svg.W))

  // Drops below each gate (dashed = rejected), with example guide
  // ids.
  let drop = fn(g : @svg.Shape, labels : Array[String]) {
    let mut w = 0.0
    for s in labels {
      w = w.max(@svg.text_width(s, size=11.0))
    }
    w = w + 16.0
    let label = labels.join("\n")
    let d = c.box(
      g.x + g.w / 2.0 - w / 2.0,
      g.y + 130.0,
      @svg.Fixed(w),
      labels.length().to_double() * 15.0 + 20.0,
      label=Some(label),
      dash=Some("5 4"),
      opacity=Some(0.85),
      size=11.0,
      pad_x=8.0,
    )
    c.arrow(c.anchor(g, @svg.S), c.anchor(d, @svg.N), dash=Some("5 4"), opacity=Some(0.7))
  }

  drop(g1, ["Temporal / built-in AI", "service worker / INP", "Web Components", "…大半"])
  drop(g2, ["custom select / slider", "autofill 住所・支払い", "carousel / scrollytelling", "対象 UI がない"])
  drop(g3, ["toast / idle detection 等", "用途・不足が薄い"])

  // The one borderline pick kept visible.
  let note = c.box(
    800.0,
    150.0,
    @svg.Auto,
    3.0 * 15.0 + 20.0,
    label=Some("speculation rules:\n宣言的 JSON だが <script> 要素\n→ 実装するかは子が判断 (wontfix 可)"),
    color=c.color(3),
    dash=Some("5 4"),
    size=11.0,
    pad_x=10.0,
  )
  c.arrow(c.anchor(out, @svg.S), c.anchor(note, @svg.N), dash=Some("5 4"), opacity=Some(0.7))

  c.text(10.0, 16.0, "schematic — dropped counts are not measured", size=11.0, opacity=Some(0.6))

  println(
    c.render(label=Some("modern-web-guidance 208 guides を3つのフィルタで絞り10タスクを採用した概略図")),
  )
}
