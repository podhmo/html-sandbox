---
import { "podhmo/svg-gen" @s }
---

// fig-squad-handoff.mbtx -- a squad of agent sessions has no shared
// memory, so the repository's document layers carry the handoff.
// The dashed arrows between sessions mark the path that does NOT
// exist; all state moves through docs/ + TODO.md below.

fn main {
  let h = 52.0
  let gx = 130.0
  let gy = 104.0
  let c = @s.Canvas::new()

  // Ephemeral workers. Colour = the mark that dies with the session.
  let s1 = c.box(0.0, 0.0, @s.Auto, h, label="実装セッション 1\n（揮発）", color=c.color(0))
  let s2 = c.box(c.right_of(s1, gx), s1.y, @s.Auto, h, label="実装セッション 2\n（揮発）", color=c.color(1))
  let s3 = c.box(c.right_of(s2, gx), s1.y, @s.Auto, h, label="実装セッション 3\n（揮発）", color=c.color(2))

  // The absent channel: dashed = the path that does not exist.
  c.arrow(c.anchor(s1, @s.E), c.anchor(s2, @s.W), dash="4 4", opacity=Some(0.5))
  c.arrow(c.anchor(s2, @s.E), c.anchor(s3, @s.W), dash="4 4", opacity=Some(0.5))
  c.text(
    s1.x + s1.w + gx / 2.0,
    s1.y + h / 2.0 - 14.0,
    "記憶は",
    anchor=@s.Middle,
    central=true,
    size=11.0,
    opacity=Some(0.65),
  )
  c.text(
    s1.x + s1.w + gx / 2.0,
    s1.y + h / 2.0 + 14.0,
    "渡らない",
    anchor=@s.Middle,
    central=true,
    size=11.0,
    opacity=Some(0.65),
  )
  c.text(
    s2.x + s2.w + gx / 2.0,
    s2.y + h / 2.0 - 14.0,
    "記憶は",
    anchor=@s.Middle,
    central=true,
    size=11.0,
    opacity=Some(0.65),
  )
  c.text(
    s2.x + s2.w + gx / 2.0,
    s2.y + h / 2.0 + 14.0,
    "渡らない",
    anchor=@s.Middle,
    central=true,
    size=11.0,
    opacity=Some(0.65),
  )

  // The persistent lane: repo documents as the squad's shared memory.
  let lane_y = s1.y + h + gy
  let lane = c.box(s1.x - 34.0, lane_y, @s.Fixed(s3.x + s3.w - s1.x + 68.0), 126.0)
  c.text(
    lane.x + lane.w / 2.0,
    lane.y + 20.0,
    "docs/ + TODO.md = 文脈を共有しないエージェントの共有メモリ",
    anchor=@s.Middle,
    central=true,
    size=12.0,
    opacity=Some(0.7),
  )

  let inner_w = (lane.w - 2.0 * 18.0 - 3.0 * 14.0) / 4.0
  let d1 = c.box(lane.x + 18.0, lane.y + 44.0, @s.Fixed(inner_w), 60.0, label="decisions/\n決定の記録", size=12.0)
  let d2 = c.box(c.right_of(d1, 14.0), d1.y, @s.Fixed(inner_w), 60.0, label="sketch/\n検証レポート", size=12.0)
  let d3 = c.box(c.right_of(d2, 14.0), d1.y, @s.Fixed(inner_w), 60.0, label="problems/\n未決の懸念", size=12.0)
  let d4 = c.box(c.right_of(d3, 14.0), d1.y, @s.Fixed(inner_w), 60.0, label="TODO.md\nタスク＋依存", size=12.0)

  // Write arrows drop from each session; handoff arrows rise into
  // the next one. Offset pairs so read and write stay
  // distinguishable.
  let mid_x = fn(s : @s.Shape) { s.x + s.w / 2.0 }
  let ox = 12.0

  c.arrow((mid_x(s1), s1.y + h), (mid_x(s1), lane.y), color=c.color(0))
  c.text(
    mid_x(s1) + 10.0,
    s1.y + h + gy / 2.0,
    "書く",
    anchor=@s.Start,
    central=true,
    size=11.0,
    opacity=Some(0.65),
  )

  for e in [(s2, 1), (s3, 2)] {
    let (s, i) = e
    c.arrow((mid_x(s) - ox, lane.y), (mid_x(s) - ox, s.y + h), color=c.color(i))
    c.arrow((mid_x(s) + ox, s.y + h), (mid_x(s) + ox, lane.y), color=c.color(i))
  }
  c.text(
    mid_x(s2) - ox - 10.0,
    s2.y + h + gy / 2.0 - 12.0,
    "読む",
    anchor=@s.End,
    central=true,
    size=11.0,
    opacity=Some(0.65),
  )
  c.text(
    mid_x(s2) + ox + 10.0,
    s2.y + h + gy / 2.0 - 12.0,
    "書く",
    anchor=@s.Start,
    central=true,
    size=11.0,
    opacity=Some(0.65),
  )

  if !(s1.y == s2.y && s2.y == s3.y) {
    abort("session row must be aligned")
  }
  for d in [d1, d2, d3, d4] {
    if !(
        d.x >= lane.x && d.x + d.w <= lane.x + lane.w &&
        d.y >= lane.y && d.y + d.h <= lane.y + lane.h
      ) {
      abort("doc boxes must sit inside the shared-memory lane")
    }
  }
  if !(d4.x + d4.w <= lane.x + lane.w - 10.0) {
    abort("last doc box must not touch the lane edge")
  }

  println(
    c.render(label="squad handoff: three coloured session boxes sit above a document lane (decisions, sketch, problems, TODO); dashed arrows between sessions mark the missing direct channel while coloured arrows show each session writing down into the lane and the next session reading up from it"),
  )
}
