---
import { "podhmo/svg-gen" @s }
---

// fig-media-art.mbtx -- "generative art" usage of the two
// structures, from the SAME point set
// (docs/sketch/ja/delaunay-voronoi.md): left panel fills Voronoi
// cells like stained glass, right panel fills Delaunay triangles
// like low-poly facets. The point: two art idioms, one point
// set, and they are duals of each other.

fn main {
  let s = @s.sites
  let tris = @s.delaunay(s)
  let c = @s.Canvas()

  // Panel layout: left panel uses S as-is; right panel is S +
  // (DX, 0).
  let dx = 280.0
  let clip = [(15.0, 15.0), (210.0, 15.0), (210.0, 210.0), (15.0, 210.0)] // clip rect for unbounded cells

  // Left: Voronoi cells filled (stained glass idiom).
  for i, site in s {
    let cell = @s.voronoi_cell(site, sites=s, rect=clip)
    if cell.length() < 3 {
      abort("site \{i} has a visible cell")
    }
    c.raw(@s.poly_el(cell, fill=c.color(i), opacity=0.35), covered=cell)
  }
  c.text(112.0, 228.0, "Voronoi cells", anchor=@s.Middle, size=12.0, opacity=Some(0.7))

  // Right: Delaunay triangles filled (low-poly facet idiom).
  let t = @s.shift(s, dx=dx, dy=0.0)
  for i, tri in tris {
    let pts = [t[tri.0], t[tri.1], t[tri.2]]
    c.raw(@s.poly_el(pts, fill=c.color(i), opacity=0.45), covered=pts)
  }
  c.text(112.0 + dx, 228.0, "Delaunay triangles", anchor=@s.Middle, size=12.0, opacity=Some(0.7))

  // Same site dots on top of both panels — the shared input.
  for p in s + t {
    c.raw(
      "<circle cx=\"\{p.0}\" cy=\"\{p.1}\" r=\"3\" fill=\"currentColor\"/>",
      covered=[p],
    )
  }

  println(
    c.render(label="generative-art idioms from one point set: filled Voronoi cells (stained glass) and filled Delaunay triangles (low-poly)"),
  )
}
