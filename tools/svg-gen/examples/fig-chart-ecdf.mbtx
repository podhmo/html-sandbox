---
import {
  "podhmo/svg-gen" @s,
  "moonbitlang/core/math" @math,
}
---

// fig-chart-ecdf.mbtx -- ECDF of request latency for two release
// versions. The "distribution" branch of the chart-selection flow:
// for a developer audience the first choice is ECDF (any percentile
// is readable directly, no bin width to declare). Data is virtual —
// lognormal samples from a seeded PRNG, regenerated identically
// every run.

fn main {
  let c = @s.Canvas()
  let g = @s.gauss(@s.rng(20261101U))
  let sample = fn(mu : Double, sigma : Double, n : Int) {
    let arr = Array::makei(n, fn(_i) { @math.exp(mu + sigma * g()) })
    arr.sort()
    arr
  }

  // virtual request latency (ms), before and after a deploy
  let v22 = sample(@math.ln(140.0), 0.55, 600)
  let v23 = sample(@math.ln(105.0), 0.5, 600)

  let gain = (
      (1.0 - @s.quantile(v23, q=0.99) / @s.quantile(v22, q=0.99)) * 100.0
    ).round()
  let gain_i = gain.to_int64()

  let p = @s.Plot(
    c,
    {
      title: "v2.3 で p99 レイテンシが \{gain_i}% 改善（仮想データ）",
      subtitle: "us-east-1 相当の仮想計測、2026-10-01〜10-14、n = 600 / version、生値",
      footnote: "出典: 仮想データ (seed 20261101) / n = 600×2 / 集計: なし（生値の ECDF）/ 生成: tools/svg-gen/examples/fig-chart-ecdf.mbtx",
    },
    (0.0, 900.0),
    (0.0, 1.0),
    w=420.0,
    h=190.0,
    xtitle=Some("レイテンシ (ms)"),
    ytitle=Some("累積割合"),
    yfmt=fn(v) { @s.fixed(v, d=1) },
    grid=true,
  )
  p.frame()
  // faint guides at p50 / p90 / p99 so the improvement is readable
  // off axes.
  p.data(fn(p) {
    for q in [0.5, 0.9, 0.99] {
      p.hline(q, label=Some("p\{(q * 100.0).to_int64()}"), opacity=0.25)
    }
    // stride-thinned to ~150 vertices per curve for inline embedding;
    // the ECDF statistic itself is unchanged.
    // v2.2 is the grey baseline; v2.3 gets the one palette accent
    // (the guideline's "highlight = one colour, rest grey").
    p.step(p.ecdf_points(samples=v22, max=150.0), opacity=Some(0.65))
    p.step(p.ecdf_points(samples=v23, max=150.0), width=2.5, color=c.color(0))
  })
  // direct labels where the curves are far apart (near their p80).
  let at = fn(sm : Array[Double], q : Double) {
    p.xs.map(@s.quantile(sm, q=q))
  }
  let y80 = p.ys.map(0.8)
  c.text(
    at(v22, 0.8) + 6.0,
    y80,
    "v2.2",
    central=true,
    size=11.0,
    opacity=Some(0.65),
  )
  c.text(at(v23, 0.8) + 6.0, y80 - 14.0, "v2.3", central=true, size=11.0)

  if !(gain > 0.0) {
    abort("v2.3 improves p99 over v2.2")
  }

  println(
    c.render(label=Some("ECDF of request latency: p99 improves \{gain_i}% in v2.3 (virtual data)")),
  )
}
