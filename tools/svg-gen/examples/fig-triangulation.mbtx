---
import { "podhmo/svg-gen" @s }
---

// fig-triangulation.mbtx -- P4: a triangulation fills the convex hull
// with non-crossing triangles (left). A chord across the middle
// crosses several edges (right, vermillion) — not a triangulation.

fn main {
  let s = @s.sites
  let tris = @s.delaunay(s)
  let c = @s.Canvas::new()
  let dx = 260.0

  let dot = fn(p : @s.Point) {
    c.raw(
      "<circle cx=\"\{p.0}\" cy=\"\{p.1}\" r=\"3.5\" fill=\"currentColor\"/>",
      covered=[p],
    )
  }

  // Left: a valid triangulation (the Delaunay one) filling the hull.
  for t in tris {
    for e in [(0, 1), (1, 2), (2, 0)] {
      let ea = if e.0 == 0 { t.0 } else if e.0 == 1 { t.1 } else { t.2 }
      let eb = if e.1 == 0 { t.0 } else if e.1 == 1 { t.1 } else { t.2 }
      c.line(s[ea], s[eb], width=1.2)
    }
  }
  for p in s {
    dot(p)
  }
  c.text(115.0, 225.0, "a triangulation", anchor=@s.Middle, size=12.0, opacity=Some(0.7))

  // Right: same edges plus one chord through the middle — it crosses
  // Delaunay edges it is not part of, so this is not a triangulation.
  let t2 = @s.shift(s, dx, 0.0)
  for t in tris {
    for e in [(0, 1), (1, 2), (2, 0)] {
      let ea = if e.0 == 0 { t.0 } else if e.0 == 1 { t.1 } else { t.2 }
      let eb = if e.1 == 0 { t.0 } else if e.1 == 1 { t.1 } else { t.2 }
      c.line(t2[ea], t2[eb], width=1.2, opacity=Some(0.5))
    }
  }
  // find two non-adjacent sites whose chord crosses the most edges
  let hv = @s.hull(s)
  let mut chord : (@s.Point, @s.Point)? = None
  let mut crossings : Array[@s.Point] = []
  for i = 0; i < s.length() && chord is None; i = i + 1 {
    for j = i + 1; j < s.length() && chord is None; j = j + 1 {
      if hv.contains(i) && hv.contains(j) {
        continue
      }
      let xs : Array[@s.Point] = []
      for entry in @s.edge_adjacency(tris) {
        let (ea, eb, _ts) = entry
        if ea == i || ea == j || eb == i || eb == j {
          continue
        }
        let a = s[ea]
        let b = s[eb]
        let d1 = (s[j].0 - s[i].0) * (a.1 - s[i].1) - (s[j].1 - s[i].1) * (a.0 - s[i].0)
        let d2 = (s[j].0 - s[i].0) * (b.1 - s[i].1) - (s[j].1 - s[i].1) * (b.0 - s[i].0)
        let d3 = (b.0 - a.0) * (s[i].1 - a.1) - (b.1 - a.1) * (s[i].0 - a.0)
        let d4 = (b.0 - a.0) * (s[j].1 - a.1) - (b.1 - a.1) * (s[j].0 - a.0)
        if d1 * d2 < 0.0 && d3 * d4 < 0.0 {
          xs.push(((a.0 + b.0) / 2.0 + dx, (a.1 + b.1) / 2.0))
        }
      }
      if xs.length() >= 2 {
        chord = Some((t2[i], t2[j]))
        crossings = xs
      }
    }
  }
  if chord is None {
    abort("found a crossing chord")
  }
  let (ca, cb) = chord.unwrap()
  c.line(ca, cb, width=2.5, color=c.color(3))
  for x in crossings {
    c.raw(
      "<circle cx=\"\{x.0}\" cy=\"\{x.1}\" r=\"4\" fill=\"none\" stroke=\"\{c.color(3)}\" stroke-width=\"2\"/>",
      covered=[x],
    )
  }
  for p in t2 {
    dot(p)
  }
  c.text(115.0 + dx, 225.0, "crossing edge: not a triangulation", anchor=@s.Middle, size=12.0, opacity=Some(0.7))

  println(
    c.render(label="valid triangulation vs a chord that crosses existing edges"),
  )
}
