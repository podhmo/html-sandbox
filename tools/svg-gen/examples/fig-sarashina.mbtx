---
import { "podhmo/svg-gen" @svg }
---

// fig-sarashina.mbtx -- the supervision figure from
// slops/2026-10-30-pi-sarashina-dogfooding.md/README.md redrawn
// with the generator. In the original, pi agent -> trace-proxy ->
// Sarashina API only had request-direction arrows; here they are
// bidirectional, since a response always comes back.

fn main {
  let c = @svg.Canvas()
  let dash = Some("4 3")

  // Row 1: the people and the code
  let human = c.box(20.0, 20.0, @svg.Auto, 40.0, label=Some("人"), size=13.0)
  let devin = c.box(c.right_of(human, 70.0), human.y, @svg.Auto, 40.0, label=Some("Devin CLI"), size=13.0)
  let ext = c.box(c.right_of(devin, 60.0), human.y, @svg.Auto, 40.0, label=Some("pi-sarashina 拡張"), size=13.0)

  // Row 2: the runtime
  let pi = c.box(devin.x, devin.y + 110.0, @svg.Auto, 44.0, label=Some("pi agent"), size=13.0)
  let proxy = c.box(c.right_of(pi, 50.0), pi.y, @svg.Auto, 44.0, label=Some("trace-proxy :8787"), size=12.0)
  let api = c.box(c.right_of(proxy, 45.0), pi.y, @svg.Auto, 44.0, label=Some("Sarashina\nAPI"), size=11.0)

  // Row 3: what pi writes
  let files = c.box(pi.x, c.below(pi, 54.0), @svg.Auto, 40.0, label=Some("main.go, *.txt"), size=12.0)

  // Edges
  let label = fn(s : String, p : @svg.Point, dy : Double, size : Double) {
    c.text(p.0, p.1 + dy, s, anchor=@svg.Middle, size=size)
  }

  c.arrow(c.anchor(human, @svg.E), c.anchor(devin, @svg.W))
  label("指示", c.midpoint(c.anchor(human, @svg.E), c.anchor(devin, @svg.W)), -8.0, 11.0)

  c.arrow(c.anchor(devin, @svg.E), c.anchor(ext, @svg.W))
  label("実装", c.midpoint(c.anchor(devin, @svg.E), c.anchor(ext, @svg.W)), -8.0, 11.0)

  c.arrow(c.anchor(devin, @svg.S), c.anchor(pi, @svg.N), dash=dash)
  let m1 = c.midpoint(c.anchor(devin, @svg.S), c.anchor(pi, @svg.N))
  c.text(m1.0 - 8.0, m1.1, "実行・監督", anchor=@svg.End, size=11.0)

  c.arrow(
    c.anchor(ext, @svg.S),
    c.anchor(pi, @svg.N),
    via=[
      (c.anchor(ext, @svg.S).0, pi.y - 44.0),
      (c.anchor(pi, @svg.N).0 + 40.0, pi.y - 44.0),
      (c.anchor(pi, @svg.N).0 + 40.0, c.anchor(pi, @svg.N).1),
    ],
    dash=dash,
  )
  c.text(
    c.anchor(ext, @svg.S).0 - 45.0,
    pi.y - 52.0,
    "pi -e でロード",
    anchor=@svg.Middle,
    size=11.0,
  )

  // Request and response as two opposing arrows, not one
  // double-headed line.
  let split = 12.0
  c.arrow(c.anchor(pi, @svg.E), c.anchor(proxy, @svg.W), ends=@svg.Pair(split))
  c.arrow(c.anchor(proxy, @svg.E), c.anchor(api, @svg.W), ends=@svg.Pair(split))
  for e in [(pi, proxy, "HTTP", 11.0), (proxy, api, "HTTPS", 10.0)] {
    let (a, b, s, size) = e
    let m = c.midpoint(c.anchor(a, @svg.E), c.anchor(b, @svg.W))
    c.text(m.0, m.1 - split / 2.0 - 8.0, s, anchor=@svg.Middle, size=size)
  }

  c.arrow(c.anchor(pi, @svg.S), c.anchor(files, @svg.N))
  let m2 = c.midpoint(c.anchor(pi, @svg.S), c.anchor(files, @svg.N))
  c.text(m2.0 + 8.0, m2.1, "write/edit", anchor=@svg.Start, size=11.0)

  println(
    c.render(label=Some("作業の構造: 人は Devin に指示するだけで、Devin が拡張を実装し、pi を実行・監督する。pi は拡張をロードしてプロキシ越しに Sarashina API を呼びながら Go のファイルを書く")),
  )
}
