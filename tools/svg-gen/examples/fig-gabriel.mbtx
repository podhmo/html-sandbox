---
import {
  "podhmo/svg-gen" @s,
  "moonbitlang/core/math" @math,
}
---

// fig-gabriel.mbtx -- X1: a Delaunay edge need not be a Gabriel
// edge. Obtuse triangle: the longest edge pq has an empty
// circumcircle (so it is Delaunay), but the circle with pq as
// diameter contains r (so it is not Gabriel). Being Gabriel
// means the *diameter* circle is empty; Delaunay only needs
// *some* empty circle through both endpoints.

fn main {
  let p : @s.Point = (55.0, 130.0)
  let q : @s.Point = (190.0, 130.0)
  let r : @s.Point = (125.0, 80.0)
  let c = @s.Canvas::new()

  let mid : @s.Point = ((p.0 + q.0) / 2.0, (p.1 + q.1) / 2.0)
  let dr = @math.hypot(p.0 - q.0, p.1 - q.1) / 2.0
  let cc = @s.circum(p, q, r)

  // checks the figure depends on: obtuse at r, r inside diameter
  // circle.
  if !(@math.hypot(r.0 - mid.0, r.1 - mid.1) < dr) {
    abort("r inside diameter circle")
  }
  if !((@math.hypot(r.0 - cc.o.0, r.1 - cc.o.1) - cc.r).abs() < 1.0e-9) {
    abort("circumcircle through all three")
  }

  for e in [(p, q), (q, r), (r, p)] {
    c.line(e.0, e.1, width=1.5)
  }
  c.line(p, q, width=3.0, color=c.color(0))
  ignore(c.circle(cc.o.0, cc.o.1, cc.r, opacity=Some(0.5)))
  ignore(c.circle(mid.0, mid.1, dr, dash="5 3", width=1.5, color=c.color(3)))
  for x in [p, q] {
    c.raw(
      "<circle cx=\"\{x.0}\" cy=\"\{x.1}\" r=\"4\" fill=\"currentColor\"/>",
      covered=[x],
    )
  }
  c.raw(
    "<circle cx=\"\{r.0}\" cy=\"\{r.1}\" r=\"4\" fill=\"\{c.color(3)}\"/>",
    covered=[r],
  )
  // keep labels below every circle: text inside a circle bounds must
  // fit it.
  c.text(
    mid.0,
    cc.o.1 + cc.r + 16.0,
    "solid circle: circumcircle, empty",
    anchor=@s.Middle,
    size=11.0,
    opacity=Some(0.7),
  )
  c.text(
    mid.0,
    cc.o.1 + cc.r + 30.0,
    "dashed circle: diameter, contains r",
    anchor=@s.Middle,
    size=11.0,
    opacity=Some(0.7),
  )

  println(
    c.render(label="longest edge of an obtuse triangle: its circumcircle is empty (Delaunay) but its diameter circle holds the third vertex (not Gabriel)"),
  )
}
