---
import { "podhmo/svg-gen" @svg }
---

// fig-repl-completion-pipe.mbtx -- what one TAB press walks through
// in minigo's REPL completer. The green (static) tier resolves the
// selector base from AST alone; the vermillion (eval) tier may run
// user code. Dashed = gates that can end the pipeline with no
// candidates. Vertical layout so the figure stays readable on
// narrow (mobile) screens.

fn main {
  let c = @svg.Canvas()
  let h = 56.0
  let gap = 26.0
  let colx = 170.0

  let input = c.box(colx, 0.0, @svg.Auto, h, label=Some("`strings.To`\nline + cursor"), size=13.0)
  let ctx = c.box(colx, c.below(input, gap), @svg.Auto, h, label=Some("completeContext\nscanner offsets"), size=13.0, color=c.color(0))
  let base = c.box(colx, c.below(ctx, gap), @svg.Auto, h, label=Some("resolveBase\nwhat is left of `.`"), size=13.0)

  // suppression exit on the left of the context box
  let suppress = c.box(
    c.left_of(ctx, 20.0, 140.0),
    ctx.y + 10.0,
    @svg.Fixed(140.0),
    36.0,
    label=Some("no candidates"),
    size=12.0,
    dash=Some("5 3"),
    opacity=Some(0.85),
  )

  // two resolution tiers side by side below the base
  let tier_y = c.below(base, gap)
  let statik = c.box(0.0, tier_y, @svg.Auto, h, label=Some("resolveExpr\nAST walk only"), size=13.0, color=c.color(2))
  let evaled = c.box(c.right_of(statik, 60.0), tier_y, @svg.Auto, h, label=Some("evalBase (opt-in)\nEvalExpr + memo"), size=13.0, color=c.color(3))

  let members = c.box(colx, c.below(statik, gap), @svg.Auto, h, label=Some("members / keys\ndedupe + Ambiguous"), size=13.0)
  let splice = c.box(colx, c.below(members, gap), @svg.Auto, h, label=Some("splice prefix\nor list"), size=13.0)

  c.arrow(c.anchor(input, @svg.S), c.anchor(ctx, @svg.N))
  c.arrow(c.anchor(ctx, @svg.S), c.anchor(base, @svg.N))
  c.arrow(c.anchor(base, @svg.S), c.anchor(statik, @svg.N), color=c.color(2))
  c.arrow(c.anchor(base, @svg.S), c.anchor(evaled, @svg.N), color=c.color(3), dash=Some("5 3"))
  c.arrow(c.anchor(statik, @svg.S), c.anchor(members, @svg.N), color=c.color(2))
  c.arrow(c.anchor(evaled, @svg.S), c.anchor(members, @svg.N), color=c.color(3), dash=Some("5 3"))
  c.arrow(c.anchor(members, @svg.S), c.anchor(splice, @svg.N))

  // dashed gate: context may veto the whole walk (index slot,
  // string tail)
  c.arrow(c.anchor(ctx, @svg.W), c.anchor(suppress, @svg.E), dash=Some("5 3"), color=c.color(1))

  if !(statik.y + statik.h < members.y) {
    abort("tiers must not overlap members")
  }
  if !(statik.x + statik.w < evaled.x) {
    abort("tiers must not overlap each other")
  }
  if !(suppress.x + suppress.w < ctx.x) {
    abort("suppress exit sits left of the pipeline")
  }

  println(
    c.render(label=Some("TAB completion pipeline: context scan, two base-resolution tiers, member enumeration, splice")),
  )
}
