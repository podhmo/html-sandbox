---
import { "podhmo/svg-gen" @svg }
---

// fig-lora-gap.mbtx -- the real blocker is not training cost ($2)
// but the format gap: the pipeline ends in PNG, and slops bundles
// cannot host raster. SVG went through the same question already
// and got an embed route; MathML (issue #73) is the same family
// of question, still open.

fn main {
  let c = @svg.Canvas(margin=12.0)

  let data = c.box(20.0, 60.0, @svg.Auto, 40.0, label=Some("DADS素材\n74枚"), color=c.color(0))
  let train = c.box(160.0, 60.0, @svg.Auto, 40.0, label=Some("学習\n~$2"), color=c.color(1))
  let lora = c.box(300.0, 60.0, @svg.Auto, 40.0, label=Some("LoRA\n.safetensors"), color=c.color(2))
  let png = c.box(510.0, 60.0, @svg.Auto, 40.0, label=Some("生成\nPNG"), color=c.color(3))
  let wall = c.box(660.0, 60.0, @svg.Auto, 40.0, label=Some("slops\nPNG不可"), color=c.color(4))

  c.arrow(c.anchor(data, @svg.E), c.anchor(train, @svg.W))
  c.arrow(c.anchor(train, @svg.E), c.anchor(lora, @svg.W))
  c.arrow(c.anchor(lora, @svg.E), c.anchor(png, @svg.W))
  c.arrow(c.anchor(png, @svg.E), c.anchor(wall, @svg.W), dash=Some("6 4"))

  // the same wall, earlier: SVG already got its embed route
  let svg = c.box(310.0, 170.0, @svg.Auto, 40.0, label=Some("SVG\nフェンス"), color=c.color(5))
  let ok = c.box(660.0, 170.0, @svg.Auto, 40.0, label=Some("埋め込み可"), color=c.color(1))
  c.arrow(c.anchor(svg, @svg.E), c.anchor(ok, @svg.W))

  // the same question, still open: MathML
  let math = c.box(310.0, 250.0, @svg.Auto, 40.0, label=Some("MathML\nissue #73"))
  let open = c.box(660.0, 250.0, @svg.Auto, 40.0, label=Some("未回答"))
  c.arrow(c.anchor(math, @svg.E), c.anchor(open, @svg.W), dash=Some("4 4"))

  c.text(
    20.0,
    320.0,
    "同じ壁: 「このフォーマットにその表現形式を載せるか」— PNGがぶつかるのは3例目",
    size=12.0,
    opacity=Some(0.8),
  )

  println(
    c.render(label=Some("pipeline from DADS assets to a PNG that slops cannot host; SVG already has an embed route, MathML issue 73 is still open")),
  )
}
