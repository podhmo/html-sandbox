---
import {
  "podhmo/svg-gen" @svg,
}
---

// fig-curve-builder.mbtx -- typed curve assembly: pie/donut slices use
// arcs without hand-written path data, and the lower series uses a
// Catmull-Rom smooth path through data points. The dashed polyline under
// it shows the uns smoothed point sequence.

///|
fn main {
  let c = @svg.Canvas()

  c.text(20.0, 22.0, "pie / donut slices", size=13.0)
  let pie_a = @svg.pie_slice(80.0, 85.0, 42.0, start=-90.0, end=45.0)
  let pie_b = @svg.pie_slice(80.0, 85.0, 42.0, start=45.0, end=160.0)
  let pie_c = @svg.pie_slice(80.0, 85.0, 42.0, start=160.0, end=270.0)
  c.draw_path(
    pie_a,
    fill=c.color(0),
    fill_opacity=Some(0.35),
    color=c.color(0),
    width=1.5,
  )
  c.draw_path(
    pie_b,
    fill=c.color(1),
    fill_opacity=Some(0.35),
    color=c.color(1),
    width=1.5,
  )
  c.draw_path(
    pie_c,
    fill=c.color(2),
    fill_opacity=Some(0.35),
    color=c.color(2),
    width=1.5,
  )

  let donut_a = @svg.donut_slice(
    205.0,
    85.0,
    20.0,
    42.0,
    start=-90.0,
    end=100.0,
  )
  let donut_b = @svg.donut_slice(
    205.0,
    85.0,
    20.0,
    42.0,
    start=100.0,
    end=270.0,
  )
  c.draw_path(
    donut_a,
    fill=c.color(3),
    fill_opacity=Some(0.35),
    color=c.color(3),
    width=1.5,
  )
  c.draw_path(
    donut_b,
    fill=c.color(4),
    fill_opacity=Some(0.35),
    color=c.color(4),
    width=1.5,
  )

  c.text(20.0, 158.0, "smooth path through points", size=13.0)
  let pts = [
    (30.0, 215.0),
    (65.0, 190.0),
    (100.0, 205.0),
    (140.0, 174.0),
    (180.0, 198.0),
    (225.0, 181.0),
    (265.0, 205.0),
  ]
  c.draw_path(
    @svg.polyline_path(pts),
    dash=Some("4 4"),
    opacity=Some(0.35),
    width=1.2,
  )
  c.draw_path(@svg.smooth_path(pts), width=2.5, color=c.color(0))
  for p in pts {
    ignore(c.circle(p.0, p.1, 3.0, fill="currentColor", width=0.0))
  }

  println(
    c.render(
      label=Some(
        "Typed path builder: pie and donut slices plus a smooth curve through points",
      ),
    ),
  )
}
