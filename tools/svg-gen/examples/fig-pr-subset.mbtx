---
import { "podhmo/svg-gen" @s }
---

// fig-pr-subset.mbtx -- the tracker's feature set as a subset of
// GitHub: colored boxes are implemented, muted dashed boxes are
// not.

fn main {
  let c = @s.Canvas::new()
  let imp = [0, 1, 2, 3, 4, 5]

  let outer = c.box(0.0, 0.0, @s.Fixed(720.0), 344.0, rx=12.0, dash="6 4")
  c.text(outer.x + 16.0, outer.y + 26.0, "GitHub (as a product)", size=15.0)

  let h = 40.0
  let gap_x = 24.0
  let gap_y = 20.0
  let col_w = 150.0
  let x0 = outer.x + 24.0
  let y0 = outer.y + 44.0

  let cell = fn(col : Double, row : Double, label : String, i : Int) -> @s.Shape {
    c.box(
      x0 + col * (col_w + gap_x),
      y0 + row * (h + gap_y),
      @s.Fixed(col_w),
      h,
      label=label,
      color=c.color(i),
      width=2.0,
    )
  }

  // implemented: left column = social objects, middle = delivery,
  // right = PR
  ignore(cell(0.0, 0.0, "issues + comments", imp[0]))
  ignore(cell(0.0, 1.0, "labels", imp[0]))
  ignore(cell(0.0, 2.0, "discussions (Q&A)", imp[0]))
  ignore(cell(0.0, 3.0, "hide/edit history", imp[0]))
  ignore(cell(1.0, 0.0, "markdown export", imp[1]))
  ignore(cell(1.0, 1.0, "JSON API /api/v1", imp[1]))
  ignore(cell(1.0, 2.0, "gh-style CLI", imp[1]))
  ignore(cell(1.0, 3.0, "SSE live updates", imp[1]))
  ignore(cell(2.0, 0.0, "pull requests", imp[2]))
  ignore(cell(2.0, 1.0, "review comments", imp[2]))
  ignore(cell(2.0, 2.0, "merge 3 methods", imp[2]))
  ignore(cell(2.0, 3.0, "conflict check", imp[2]))

  // not implemented: muted row at the bottom
  let y1 = y0 + 4.0 * (h + gap_y) + 4.0
  let off = fn(x : Double, label : String) {
    ignore(
      c.box(x, y1, @s.Fixed(col_w), h, label=label, dash="5 4", opacity=Some(0.45)),
    )
  }
  off(x0, "review verdicts")
  off(x0 + (col_w + gap_x), "CI / actions")
  off(x0 + 2.0 * (col_w + gap_x), "forks / releases")
  off(x0 + 3.0 * (col_w + gap_x), "permissions")

  c.text(
    x0,
    y1 - 10.0,
    "implemented — solid strokes; skipped — dashed",
    size=12.0,
    opacity=Some(0.7),
  )

  println(
    c.render(label="GitHub 本体に対する実装済み機能の subset 関係図"),
  )
}
