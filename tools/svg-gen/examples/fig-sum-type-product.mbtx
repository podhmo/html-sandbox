---
import { "podhmo/svg-gen" @s }
---

// fig-sum-type-product.mbtx -- "One state in two places" seen as a
// product grid. Each panel crosses the two type locations that
// together carried one state: Route.subtree x the last segment,
// and scan's Mode x Pending. Cells the code can produce are marked
// O; cells the types allow but no input produces are marked x.
// Folding the state into one enum leaves only the O cells — that
// is the "impossible combinations in the product" of the
// guidelines' second sign.

fn main {
  let c = @s.Canvas()
  let cw = 58.0
  let ch = 26.0
  let hdr = 11.0
  let gapx = 48.0

  // A product grid: row/col labels, O where the combination can
  // occur, x where the types allow it but nothing produces it.
  let grid = fn(
    x : Double,
    y : Double,
    title : String,
    cols : Array[String],
    rows : Array[String],
    real : (Int, Int) -> Bool,
    caption : String,
  ) -> @s.Shape {
    c.text(x, y - 22.0, title, size=13.0, underline=@s.Yes)
    let mut label_w = 0.0
    for r in rows {
      label_w = label_w.max(@s.text_width(r, size=hdr))
    }
    label_w = label_w + 8.0
    for j, col in cols {
      c.text(x + label_w + j.to_double() * cw + cw / 2.0, y - 6.0, col, anchor=@s.Middle, size=hdr)
    }
    for i, row in rows {
      c.text(
        x + label_w - 6.0,
        y + i.to_double() * ch + ch / 2.0,
        row,
        anchor=@s.End,
        central=true,
        size=hdr,
      )
      for j, _col in cols {
        let ok = real(i, j)
        let cell = c.box(
          x + label_w + j.to_double() * cw,
          y + i.to_double() * ch,
          @s.Fixed(cw),
          ch,
          rx=2.0,
          opacity=Some(if ok { 1.0 } else { 0.25 }),
          width=(if ok { 1.5 } else { 1.0 }),
        )
        c.text(
          cell.x + cell.w / 2.0,
          cell.y + cell.h / 2.0,
          if ok { "O" } else { "x" },
          anchor=@s.Middle,
          central=true,
          size=(if ok { 13.0 } else { 12.0 }),
          opacity=Some(if ok { 1.0 } else { 0.35 }),
        )
      }
    }
    let w = label_w + cols.length().to_double() * cw
    let h = rows.length().to_double() * ch
    c.text(x, y + h + 18.0, caption, size=hdr, opacity=Some(0.75))
    @s.Shape::{ x, y, w, h }
  }

  let y = 62.0
  let route = grid(
    24.0,
    y,
    "Route: subtree x 最後の segment",
    ["lit/{x}", "{$}", "{x...}", "(empty)"],
    ["subtree=false", "subtree=true"],
    // false x {lit, $, x...} and true x {lit, empty} occur; the rest
    // cannot be produced by a pattern but the types allow it.
    fn(i, j) { if i == 0 { j < 3 } else { j == 0 || j == 3 } },
    "5 of 8 occur -> Tail { Exact; End; Subtree; Rest }",
  )
  let sx = route.x + route.w + gapx
  let scan = grid(
    sx,
    y,
    "scan: mode x pending",
    ["Nothing", "Para", "Items", "Quote", "Table"],
    ["Normal", "Code", "Details", "Footnote"],
    // pending is non-empty only in Normal.
    fn(i, j) { i == 0 || j == 0 },
    "8 of 20 occur -> Normal(Pending)",
  )

  if !(route.x + route.w + gapx <= scan.x) {
    abort("the two panels must not overlap")
  }
  if !(scan.w > 0.0) {
    abort("scan grid was drawn")
  }

  println(
    c.render(label=Some("product grids of the two split states; O marks combinations that occur, x marks ones the types allow but no input produces")),
  )
}
